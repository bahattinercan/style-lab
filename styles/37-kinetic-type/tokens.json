        "focus": "outline 2px solid var(--accent), offset 2px",
        "disabled": "opacity .38",
        "loading": "3 çubuk, 90ms"
      }
    },
    "buttonOutline": {
      "height": "46px",
      "padding": "0 18px",
      "radius": "2px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "states": {
        "hover": "background var(--surface-2), kenar var(--ink-soft)",
        "active": "translateY(2px)"
      }
    },
    "input": {
      "height": "50px",
      "padding": "0 14px",
      "radius": "2px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "font": "15px Space Grotesk",
      "focus": "outline 2px solid var(--accent), offset 2px",
      "error": "border var(--danger) + 12px hata satırı",
      "disabled": "background var(--surface-2), opacity .5"
    },
    "card": {
      "padding": "24px",
      "radius": "4px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "featured": "üst kenar 2px var(--accent) + zemin var(--surface-2)"
    },
    "chip": {
      "height": "26px",
      "padding": "0 10px",
      "radius": "2px",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)",
      "font": "10px/400 Space Mono uppercase 0.18em",
      "active": "var(--accent) + var(--accent-ink)",
      "target": "min-height 44px padding ile"
    },
    "nav": {
      "height": "68px",
      "padding": "0 40px",
      "borderBottom": "1px solid var(--line)",
      "font": "12px/400 Space Mono uppercase 0.16em",
      "active": "2px accent alt çizgi + 6px kare nokta"
    },
    "tableRow": {
      "height": "52px",
      "padding": "12px 16px",
      "border": "1px solid var(--line) alt",
      "selected": "sol 2px accent + surface-2 zemin",
      "hover": "background var(--surface-2)"
    },
    "modal": {
      "padding": "28px",
      "radius": "4px",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "accentBar": "üst 2px var(--accent)",
      "backdrop": "rgba(14,14,16,.78)",
      "close": "44×44, radius 2px"
    },
    "toast": {
      "height": "50px",
      "radius": "2px",
      "bg": "var(--ink)",
      "color": "var(--bg)",
      "accentBar": "sol 2px var(--accent)",
      "duration": "4s"
    },
    "chart": {
      "series": "--data-1 accent, --data-2 ink, --data-3 ink-soft, --data-4 surface-2",
      "axis": "10px mono 0.14em",
      "bars": "üst köşe 2px, çubuklar arası 8px, yatay grid yok"
    }
  },
