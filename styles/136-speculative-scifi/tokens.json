  "components": {
    "button": {
      "height": "38px",
      "padding": "0 16px",
      "radius": "var(--radius)",
      "font": "11px/600 mono uppercase .16em",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "accent %86 + ink",
        "active": "translateY(1px) + iç 1px line",
        "focus": "outline 2px solid var(--accent), offset 2px",
        "disabled": "opacity .45 + kesikli çerçeve",
        "loading": "kadran tiki %0→%100 (700ms, tek tur)"
      }
    },
    "buttonSecondary": {
      "height": "38px",
      "padding": "0 16px",
      "radius": "var(--radius)",
      "bg": "transparent",
      "border": "1px solid var(--line)",
      "color": "var(--ink)"
    },
    "input": {
      "height": "38px",
      "padding": "0 12px",
      "radius": "var(--radius)",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "focus": "outline 2px solid var(--accent), offset 1px",
      "error": "border-color var(--danger) + 10px mono not"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "20px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "note": "çift çerçeve: dış 1px line + ::after inset 4px 1px line"
    },
    "chip": {
      "height": "20px",
      "padding": "0 6px",
      "radius": "var(--radius)",
      "font": "10px/500 mono .16em",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)"
    },
    "nav": {
      "height": "52px",
      "padding": "0 24px",
      "borderBottom": "1px solid var(--line)",
      "note": "alt kenarda 3px tik şeridi (1px çentikler)"
    },
    "tableRow": {
      "height": "36px",
      "padding": "6px 10px",
      "border": "yok; satır arası 1px var(--line)"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "24px",
      "border": "1px solid var(--accent)",
      "shadow": "none",
      "note": "plaka başlığı: `◈ SEKTÖR 7 · KAYIT 12` mono"
    },
    "toast": {
      "height": "34px",
      "padding": "8px 12px",
      "radius": "var(--radius)",
      "duration": "4000ms, sağ-alt",
      "note": "sol uçta 2px accent sinyal çizgisi"
    },
    "chart": {
      "series": "var(--accent), var(--ink-soft), var(--warn), var(--danger)",
      "maxSeries": 4,
      "note": "kadran yayı + tik; sütun grafiği yok"
    }
  },
  "motion": {
    "fast": "90ms",
    "base": "200ms",
