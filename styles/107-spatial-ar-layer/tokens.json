  "css": "[data-style=\"spatial-ar-layer\"] { --bg: #e9edf5; --bg-2: #dfe5f0; --surface: #f7f9fc; --surface-2: #eef2f9; --ink: #161a24; --ink-soft: #4a5364; --ink-faint: #78818f; --accent: #2a4bd7; --accent-ink: #ffffff; --line: rgba(22,26,36,.16); --radius: 12px; --radius-lg: 20px; --shadow: 0 18px 40px rgba(22,26,36,.14); --shadow-hard: none; --font-display: \"Chakra Petch\", \"Jost\", system-ui, sans-serif; --font-body: \"Jost\", \"Inter\", system-ui, sans-serif; --font-mono: \"Share Tech Mono\", \"IBM Plex Mono\", ui-monospace, monospace; --tracking: .02em; --blur: 6px; --grain: 2; --danger: #a52a3c; --danger-ink: #ffffff; --ok: #1f6b3f; --warn: #7a5300; }",
