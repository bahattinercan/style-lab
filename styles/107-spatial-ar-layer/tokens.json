      "64px"
    ],
    "sectionY": {
      "desktop": "76px",
      "mobile": "44px"
    },
    "cardPadding": "22px"
  },
  "grid": {
    "columns": 12,
    "gutter": "20px",
    "container": "1200px",
    "measure": "62ch",
    "breakpoints": {
      "sm": "390px",
      "md": "768px",
      "lg": "1200px"
