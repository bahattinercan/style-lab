    "photo": "int-02.jpg",
    "treatment": {
      "mode": "scrim",
      "strength": 0.4
    }
  },
  "components": {
    "button": {
      "height": "42px",
      "padding": "0 18px",
      "radius": "var(--radius)",
      "font": "13px/600 display uppercase .06em",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "0 8px 20px rgba(22,26,36,.16)",
      "states": {
        "hover": "accent %88 + ink, gölge 12/26",
        "active": "translateY(1px), gölge 4/12",
        "focus": "outline 2px solid var(--accent), offset 3px",
        "disabled": "opacity .45, kesikli çerçeve",
        "loading": "çapa halkası %0→%100 (700ms, tek tur)"
      }
    },
    "buttonSecondary": {
      "height": "42px",
      "padding": "0 18px",
      "radius": "var(--radius)",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "color": "var(--ink)"
    },
    "input": {
      "height": "42px",
      "padding": "0 14px",
      "radius": "var(--radius)",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "focus": "outline 2px solid var(--accent), offset 2px",
      "error": "border-color var(--danger) + 11px mono etiket"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "22px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "var(--shadow)",
      "note": "üst-sol köşede çapa artısı (12px), alt-solda z yüksekliği etiketi"
    },
    "chip": {
      "height": "22px",
      "padding": "0 8px",
      "radius": "var(--radius)",
      "font": "10px/600 mono .12em",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)"
    },
    "nav": {
      "height": "56px",
      "padding": "0 24px",
      "borderBottom": "1px solid var(--line)",
      "note": "yarı saydam katman: surface %72 + blur 6px, alt hairline"
    },
    "tableRow": {
      "height": "40px",
      "padding": "6px 12px",
      "border": "yok; satır arası 1px var(--line)"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "24px",
      "border": "1px solid var(--accent)",
      "shadow": "0 18px 40px rgba(22,26,36,.20)",
      "note": "z=2 katman; üst şeritte koordinat etiketi (x, y, z)"
    },
    "toast": {
      "height": "38px",
      "padding": "8px 14px",
      "radius": "var(--radius)",
      "duration": "4000ms, sağ-üst",
      "note": "sol uçta 6px accent çapa noktası"
    },
    "chart": {
      "series": "var(--accent), var(--ink-soft), var(--warn), var(--danger)",
      "maxSeries": 4,
      "note": "grafik yerine katman diyagramı; eksenler mono"
    }
  },
  "motion": {
    "fast": "140ms",
    "base": "320ms",
    "slow": "860ms",
    "easing": "cubic-bezier(.16,.9,.24,1)",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms (tokens.css global) — katman kayması ve pin statik kalır",
    "forbidden": [
      "Kullanıcı kontrolü olmayan sürekli parallax",
      "Saniyede 3 üstü flash",
      "Sert/step geçiş",
      "Yatay kaydırma hijack"
    ],
    "family": "Etkileşim",
    "sequences": {
      "enter": {
        "duration": "0.86s",
        "ease": "cubic-bezier(.16,.9,.24,1)",
        "offsetY": "25px",
        "stagger": "0.088"
      },
      "scroll": {
        "trigger": "top 73%",
        "duration": "0.81s",
        "offsetY": "28px",
        "once": true
      },
      "pin": {
        "enabled": true,
        "scrub": 0.42,
        "distance": "+105%"
      },
      "hover": {
        "duration": "285ms",
        "imageScale": "1.008"
      }
    },
    "choreography": {
      "enter": "fade-rise",
      "scroll": "parallax",
      "hover": "underline-draw",
      "page": "crossfade",
      "reduced": "static-frame"
    }
  },
  "must": [
