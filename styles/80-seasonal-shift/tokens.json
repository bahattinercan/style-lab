  "name": "Mevsim Geçişi",
  "version": 4,
  "css": "[data-style=\"seasonal-shift\"] { --bg: #f6efe2; --bg-2: #ede3d2; --surface: #fdf9f1; --surface-2: #f7f0e4; --ink: #2a2018; --ink-soft: #5c4c3d; --ink-faint: #8a7b68; --accent: #a4471f; --accent-ink: #fff6ec; --line: rgba(42,32,24,.14); --radius: 8px; --radius-lg: 16px; --shadow: 0 6px 20px rgba(42,32,24,.12); --shadow-hard: none; --font-display: \"EB Garamond\", \"Lora\", Georgia, serif; --font-body: \"Inter\", system-ui, sans-serif; --font-mono: \"JetBrains Mono\", ui-monospace, monospace; --tracking: .02em; --blur: 0px; --grain: 3; --danger: #a02a20; --danger-ink: #ffffff; --ok: #3f6b2c; --warn: #7f5a04; }",
