      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "76px",
      "mobile": "44px"
    },
    "cardPadding": "22px"
  },
  "grid": {
    "columns": 12,
    "gutter": "20px",
    "container": "1200px",
    "measure": "64ch",
    "breakpoints": {
      "sm": "390px",
      "md": "768px",
      "lg": "1200px"
    },
    "asymmetry": "geçiş çizgisi: bölümler 12 kolon ama 1 bölümde 7/5 ikili ton ayrımı — ekran başına 1 asimetrik blok"
  },
  "layout": {
    "hero": "split",
    "nav": "inline",
    "density": "sparse",
    "family": "Doğa & Organik"
  },
  "imagery": {
    "icons": "1.5px çizgi, hafif yuvarlak uç, 22px ızgara; mevsim sembolleri (yaprak, kar, güneş)",
    "photos": "mevsim geçişi fotoğrafı: sıcak-soğuk karşıtlığı, düşük doygunluk, 16px radius kırpma",
    "illustration": "iki tonlu yaprak/dal çizimi; yarısı accent, yarısı ok tonu",
    "texture": "grain %3 + ince dikey geçiş çizgisi; parlak yüzey yok",
    "logo": "serif wordmark + iki renkli yaprak işareti, 28px çevre boşluk",
    "photo": "nat-01.jpg",
    "treatment": {
      "mode": "plain",
      "strength": 0
    }
  },
  "components": {
    "button": {
      "height": "44px",
      "padding": "0 22px",
      "radius": "var(--radius)",
      "font": "15px/600 body",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "accent %86 + ink, 1px gölge",
        "active": "translateY(1px)",
        "focus": "outline 2px solid var(--accent), offset 3px",
        "disabled": "opacity .45",
        "loading": "renk geçişi accent → ok (700ms, tek tur)"
      }
    },
    "buttonSecondary": {
      "height": "44px",
      "padding": "0 22px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "color": "var(--ink)"
    },
    "input": {
      "height": "44px",
      "padding": "0 14px",
      "radius": "var(--radius)",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "focus": "outline 2px solid var(--accent), offset 2px",
      "error": "border-color var(--danger) + 12px etiket"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "22px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "var(--shadow)",
      "note": "üst kenarda 3px iki tonlu şerit (accent %40 → ok %30)"
    },
    "chip": {
      "height": "26px",
      "padding": "0 12px",
      "radius": "999px",
      "font": "12px/600 body",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)"
    },
    "nav": {
      "height": "62px",
      "padding": "0 26px",
      "borderBottom": "1px solid var(--line)",
      "note": "alt kenarda 3px iki tonlu mevsim şeridi"
    },
    "tableRow": {
      "height": "44px",
      "padding": "8px 12px",
      "border": "yok; satır arası 1px var(--line)"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "26px",
      "border": "1px solid var(--line)",
      "shadow": "0 16px 40px rgba(42,32,24,.20)",
      "note": "başlıkta mono mevsim etiketi (İLKBAHAR → YAZ)"
    },
    "toast": {
      "height": "42px",
      "padding": "10px 16px",
      "radius": "var(--radius)",
      "duration": "4200ms, alt-sağ",
      "note": "sol uçta 6px iki renkli nokta"
    },
    "chart": {
      "series": "var(--accent), var(--ok), var(--ink-soft), var(--warn)",
      "maxSeries": 4,
      "note": "çizgi 2px; mevsim sınırları 1px kesikli dikey"
    }
  },
  "motion": {
    "fast": "150ms",
    "base": "300ms",
    "slow": "570ms",
    "easing": "cubic-bezier(.42,.12,.2,1)",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms (tokens.css global) — renk geçişi ve pin statik kalır",
    "forbidden": [
      "Sürekli döngü (yaprak düşmesi) ekran başına 1 üstü",
      "Saniyede 3 üstü flash",
      "Blur geçişi",
      "Parallax (kapatma yolu yoksa)"
    ],
    "family": "Doğa & Organik",
    "sequences": {
      "enter": {
        "duration": "0.57s",
        "ease": "cubic-bezier(.42,.12,.2,1)",
        "offsetY": "22px",
        "stagger": "0.075"
      },
      "scroll": {
        "trigger": "top 96%",
        "duration": "0.57s",
        "offsetY": "44px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "220ms",
        "imageScale": "1.018"
      }
    },
    "choreography": {
      "enter": "fade-rise",
      "scroll": "reveal",
      "hover": "scale",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "must": [
    "Zemin sıcak krem (--bg); saf beyaz yok, gölge yumuşak tek katman",
