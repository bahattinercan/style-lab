    "shadow": "0 6px 20px rgba(42,32,24,.12)",
    "shadowHard": "none",
    "rule": "Derinlik iki mevsim tonundan gelir: kart --surface üstünde tek yumuşak gölge (0 6px 20px). Sert gölge yok; bölüm geçişlerinde 1px dikey hairline kullanılır."
  },
  "spacing": {
    "unit": "4px",
