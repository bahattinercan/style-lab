      "mode": "scrim",
      "strength": 0.4
    }
  },
  "components": {
    "button": {
      "height": "34px",
      "padding": "0 12px",
      "radius": "var(--radius)",
      "font": "13px/600 body",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "accent %88 + ink",
        "active": "translateY(1px)",
        "focus": "outline 2px solid var(--accent), offset 2px",
        "disabled": "opacity .45",
        "loading": "kart yer tutucu (skeleton) 3 satır, 700ms"
      }
    },
    "buttonSecondary": {
      "height": "34px",
      "padding": "0 12px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "color": "var(--ink)"
    },
    "input": {
      "height": "36px",
      "padding": "0 12px",
      "radius": "var(--radius)",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "focus": "outline 2px solid var(--accent), offset 1px",
      "error": "border-color var(--danger) + 12px etiket"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "14px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "var(--shadow)",
      "note": "kart: sol 3px etiket şeridi, üstte başlık, altta 24px avatar + etiket chip"
    },
    "chip": {
      "height": "22px",
      "padding": "0 8px",
      "radius": "999px",
      "font": "11px/600 body",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)"
    },
    "nav": {
      "height": "52px",
      "padding": "0 20px",
      "borderBottom": "1px solid var(--line)",
      "note": "üst barda tahta adı + WIP özet sayaçları (mono)"
    },
    "tableRow": {
      "height": "36px",
      "padding": "6px 10px",
      "border": "yok; satır arası 1px var(--line)"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "20px",
      "border": "1px solid var(--line)",
      "shadow": "0 12px 28px rgba(23,26,32,.18)",
      "note": "kart detayı: iki kolon (içerik + yan bilgi)"
    },
    "toast": {
      "height": "36px",
      "padding": "8px 12px",
      "radius": "var(--radius)",
      "duration": "3500ms, alt-sağ",
      "note": "taşındı onayı; sol uçta 6px accent nokta"
    },
    "chart": {
      "series": "var(--accent), var(--ok), var(--warn), var(--danger)",
      "maxSeries": 4,
      "note": "kümülatif akış grafiği (CFD): alan dolgusu %12, çizgi 2px"
    }
  },
  "motion": {
    "fast": "235ms",
    "base": "420ms",
    "slow": "730ms",
    "easing": "cubic-bezier(.3,.4,.2,1)",
