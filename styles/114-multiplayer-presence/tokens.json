{
  "slug": "multiplayer-presence",
  "num": "114",
  "name": "Eşzamanlı İşbirlikçi",
  "version": 4,
  "css": "[data-style=\"multiplayer-presence\"] { --bg: #f8f7fc; --bg-2: #eeecf8; --surface: #ffffff; --surface-2: #f4f2fc; --ink: #1b1630; --ink-soft: #514870; --ink-faint: #857ea0; --accent: #6d28d9; --accent-ink: #ffffff; --line: rgba(27,22,48,.14); --radius: 12px; --radius-lg: 20px; --shadow: 0 4px 14px rgba(27,22,48,.10); --shadow-hard: none; --font-display: \"Baloo 2\", \"Nunito\", system-ui, sans-serif; --font-body: \"Nunito\", \"Inter\", system-ui, sans-serif; --font-mono: \"JetBrains Mono\", ui-monospace, monospace; --tracking: -.005em; --blur: 0px; --grain: 0; --danger: #b3261e; --danger-ink: #ffffff; --ok: #1c6b46; --warn: #8a5a00; }",
