      "bg",
      "surface",
      "overlay"
    ],
    "shadow": "0 4px 14px rgba(27,22,48,.10)",
    "shadowHard": "none",
    "rule": "Kart hiyerarşisi: bg → surface + 1px line + 0 4px 14px. Canlı imleç ve avatar katmanı gölgesizdir; varlık (presence) gölgeyle değil renkli çerçeveyle ayrışır."
  },
  "spacing": {
    "unit": "4px",
    "scale": [
      "4px",
      "8px",
      "12px",
      "16px",
      "24px",
      "32px",
      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "60px",
      "mobile": "34px"
    },
    "cardPadding": "20px"
  },
  "grid": {
    "columns": 12,
    "gutter": "24px",
    "container": "1160px",
    "measure": "64ch",
    "breakpoints": {
      "sm": "390px",
      "md": "768px",
      "lg": "1160px"
    },
    "asymmetry": "İçerik 8 kolon + sağda 3 kolonluk canlı katılımcı paneli; ekran başına 1 asimetrik bölünme"
  },
  "layout": {
    "hero": "sticky",
    "nav": "pill",
    "density": "balanced",
    "family": "Etkileşim"
  },
  "imagery": {
    "icons": "2px çizgi, yuvarlak uç, 20px ızgara; imleç, yorum, @ bahsetme",
    "photos": "yalnız 28px yuvarlak avatar (baş harfli yedek); kahraman fotoğrafı yok",
    "illustration": "yok; imleç ve seçim vurgusu tek görsel dil",
    "texture": "grain yok; canlı seçim %12 accent zemini doku yerine geçer",
    "logo": "Baloo 2 wordmark + iki iç içe avatar halkası, 16px çevre boşluk",
    "photo": "int-02.jpg",
    "treatment": {
      "mode": "scrim",
      "strength": 0.4
    }
  },
  "components": {
    "button": {
      "height": "40px",
      "padding": "0 18px",
      "radius": "999px",
      "font": "15px/700 body",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "accent %90 + ink",
        "active": "scale .98",
        "focus": "outline 2px solid var(--accent), offset 2px",
        "disabled": "opacity .45",
        "loading": "avatar yığını yerine 3 nokta, 500ms"
      }
    },
    "buttonSecondary": {
      "height": "40px",
      "padding": "0 18px",
      "radius": "999px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "color": "var(--ink)"
    },
    "input": {
      "height": "40px",
      "padding": "0 16px",
      "radius": "999px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "focus": "border-color var(--accent) + 3px accent %22 halka",
      "error": "border-color var(--danger) + 13px açıklama"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "20px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "var(--shadow)",
      "note": "kart: sol üstte 28px avatar yığını, sağ üstte `3 kişi düzenliyor` hap, altta son düzenleme satırı"
    },
    "chip": {
      "height": "24px",
      "padding": "0 10px",
      "radius": "999px",
      "font": "12px/700 body",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)"
    },
    "nav": {
      "height": "56px",
      "padding": "0 24px",
      "borderBottom": "1px solid var(--line)",
      "note": "navda belge adı, ortada canlı avatar yığını, sağda `Paylaş` düğmesi"
    },
    "tableRow": {
      "height": "42px",
      "padding": "8px 12px",
      "border": "yok; satır arası 1px var(--line)"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "24px",
      "border": "1px solid var(--line)",
      "shadow": "0 12px 32px rgba(27,22,48,.18)",
      "note": "yorum dizisi: avatar + mono zaman damgası + yanıt kutusu"
    },
    "toast": {
      "height": "38px",
      "padding": "9px 14px",
      "radius": "999px",
      "duration": "3800ms, alt-orta",
      "note": "`Elif katıldı`; solda 20px avatar, sağda kapatma"
    },
    "chart": {
      "series": "var(--accent), var(--ok), var(--warn)",
      "maxSeries": 3,
      "note": "katkı grafiği: 2px çizgi + %12 dolgu, imleç renkleri ayrı değişken değil"
    }
  },
  "motion": {
    "fast": "210ms",
    "base": "380ms",
    "slow": "630ms",
    "easing": "cubic-bezier(.34,1.16,.64,1)",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms (tokens.css global) — imleçler konum atlar, seçim vurgusu anında belirir",
    "forbidden": [
      "İmlecin yumuşak takip gecikmesi (60ms üstü)",
      "Sürekli nabız atan avatar",
      "Blur geçişi",
      "Kartın yerinden oynaması (canlı düzenleme sırasında sıçrama)"
    ],
    "family": "Etkileşim",
    "sequences": {
      "enter": {
        "duration": "0.63s",
        "ease": "cubic-bezier(.34,1.16,.64,1)",
        "offsetY": "9px",
        "stagger": "0.033"
      },
      "scroll": {
        "trigger": "top 88%",
        "duration": "0.57s",
        "offsetY": "11px",
        "once": false
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "210ms",
        "imageScale": "1.026"
      }
    },
    "choreography": {
      "enter": "fade-rise",
      "scroll": "pin-scrub",
      "hover": "underline-draw",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "must": [
    "Her çevrimiçi kişi görünür: 28px avatar + ad baş harfi; avatar yığını en fazla 4, fazlası `+3`",
    "Uzak seçim %12 accent zemin + 1px accent çerçeve ile gösterilir; imleç ucunda 12px ad etiketi",
    "Canlı düzenleme sırasında kart yüksekliği değişse bile odak kaymaz (skeleton yok, yer tutucu var)",
    "`3 kişi düzenliyor` gibi durum hapı her zaman metinle yazılır",
    "Yorum ve bahsetme aynı anda tek aktif katman açar; ikinci katman üst üste açılmaz",
    "Çevrimdışı katkı `çevrimdışı` mono etiketi ve kesikli çerçeveyle ayrılır"
  ],
  "mustNot": [
    "Avatar olmayan \"biri düzenliyor\" belirsizliği",
    "Renk-only presence (renk + baş harf zorunlu)",
    "İmleç animasyonunda yay/overshoot birikmesi",
    "Aynı anda iki modal katman",
    "Koyu zemin + neon accent (açık modda)",
    "Serif display"
  ],
