      "accent": "#b18cff",
      "accentInk": "#150a24",
      "line": "rgba(240,236,250,.16)"
    }
  },
  "typography": {
    "display": "Baloo 2",
    "body": "Nunito",
    "mono": "JetBrains Mono",
    "scale": {
      "label": "11px",
