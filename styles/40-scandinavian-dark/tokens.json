  "components": {
    "button": {
      "height": "44px",
      "padding": "0 20px",
      "radius": "6px",
      "font": "13px/500 Inter, 0.01em",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "border": "1px solid transparent",
      "states": {
        "hover": "background color-mix(in srgb, var(--accent) 92%, var(--ink))",
        "active": "translateY(1px)",
        "focus": "outline 2px solid var(--accent), offset 2px",
        "disabled": "opacity .42",
        "loading": "3 nokta, 120ms"
      }
    },
    "buttonOutline": {
      "height": "44px",
      "padding": "0 18px",
      "radius": "6px",
      "bg": "transparent",
      "border": "1px solid var(--line)",
      "color": "var(--ink)",
      "states": {
        "hover": "background var(--surface-2)",
        "active": "translateY(1px)",
        "focus": "outline 2px solid var(--accent), offset 2px"
      }
    },
    "input": {
      "height": "46px",
      "padding": "0 14px",
      "radius": "6px",
      "bg": "var(--bg-2)",
      "border": "1px solid var(--line)",
      "font": "16px Inter",
      "focus": "outline 2px solid var(--accent), offset 2px",
      "error": "border var(--danger) + 13px hata satırı",
      "disabled": "background var(--surface-2), opacity .5"
    },
    "card": {
      "padding": "30px",
      "radius": "10px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "featured": "background var(--surface-2) + üst 2px var(--accent), gölge yok"
    },
    "chip": {
      "height": "26px",
      "padding": "0 10px",
      "radius": "4px",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)",
      "font": "10.5px/400 IBM Plex Mono uppercase 0.12em",
      "active": "var(--accent) + var(--accent-ink) + 1px transparent",
      "target": "min-height 44px padding ile"
    },
    "nav": {
      "height": "72px",
      "padding": "0 48px",
      "borderBottom": "1px solid var(--line)",
      "font": "13px/400 Inter",
      "active": "2px var(--accent) alt çizgi",
      "inactive": "var(--ink-soft)"
    },
    "tableRow": {
      "height": "52px",
      "padding": "14px 16px",
      "radius": "0 (satır), 10px (kap)",
      "border": "1px var(--line) alt",
      "selected": "sol 2px var(--accent) + var(--surface-2) zemin",
      "hover": "background var(--surface-2)"
    },
    "modal": {
      "padding": "30px",
      "radius": "10px",
      "border": "1px solid var(--line)",
      "shadow": "0 2px 10px rgba(0,0,0,.35)",
      "backdrop": "rgba(9,11,10,.62)",
      "close": "44×44, radius 6px"
    },
    "toast": {
      "height": "48px",
      "radius": "6px",
      "bg": "var(--surface-2)",
      "color": "var(--ink)",
      "accentBar": "sol 2px var(--accent)",
      "border": "1px solid var(--line)",
      "duration": "5s"
    },
    "chart": {
      "series": "--data-1 accent, --data-2 ink, --data-3 ink-soft, --data-4 surface-2",
      "axis": "10.5px mono 0.12em",
      "bars": "üst köşe 3px, çubuklar arası 12px, yatay grid yok, taban 1px var(--line)"
    }
