    "shadowHard": "6px 6px 0 var(--line)",
    "rule": "Derinlik ofset blok + kalın çizgi; yumuşak gölge ve blur yok"
  },
  "motion": {
    "fast": "90ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(.16,.84,.24,1)",
