        "note": "satır satır"
      },
      "scroll": {
        "trigger": "top 88%",
        "duration": "0.34s",
        "offsetY": "28px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": "1.0",
        "distance": "+120%"
      },
      "hover": {
        "duration": "110ms",
        "imageScale": "1.02"
      }
    },
    "choreography": {
      "enter": "fade-rise",
      "scroll": "grid-stagger",
      "hover": "scale",
      "page": "crossfade",
      "reduced": "opacity"
