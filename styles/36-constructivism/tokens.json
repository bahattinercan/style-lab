  "version": 4,
  "css": "[data-style=\"constructivism\"] { --bg: #efeae0; --bg-2: #e2dbcd; --surface: #fbf8f2; --surface-2: #e9e2d5; --ink: #11100f; --ink-soft: #5a5349; --ink-faint: #847d6f; --accent: #c1121f; --accent-ink: #fbf8f2; --line: #11100f; --radius: 0px; --radius-lg: 0px; --shadow: none; --shadow-hard: 6px 6px 0 #11100f; --font-display: \"Archivo Black\", \"Inter\", sans-serif; --font-body: \"Jost\", \"Inter\", sans-serif; --font-mono: \"Space Mono\", ui-monospace, monospace; --tracking: 0em; --blur: 0px; --grain: .03; }",
