    "columns": 12,
    "gutter": "20px",
    "container": "1160px",
    "breakpoints": {
      "sm": "640px",
      "md": "900px",
      "lg": "1160px"
    },
    "asymmetry": "hero 7/5 veya 9/3; 6/6 ortalanmış yasak; bölüm başına ≥1 öğe ızgara dışına taşar"
  },
  "layout": {
    "hero": "index",
    "nav": "split",
    "density": "dense",
    "family": "Geometrik"
  },
  "components": {
    "button": {
      "height": "46px",
      "padding": "0 24px",
      "radius": "0",
      "font": "13px/400 mono uppercase 0.14em",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "border": "3px solid var(--line)",
      "states": {
        "hover": "box-shadow var(--shadow-hard)",
        "active": "box-shadow none; translate(2px,2px)",
        "focus": "outline 3px var(--line), offset 3px",
        "disabled": "opacity .4 + dashed border",
        "loading": "3 nokta mono"
      }
    },
    "buttonOutline": {
      "height": "46px",
      "padding": "0 20px",
      "bg": "transparent",
      "border": "3px solid var(--line)",
      "states": {
        "hover": "background var(--surface-2)",
        "active": "translate(2px,2px)"
      }
    },
    "input": {
      "height": "46px",
      "padding": "0 14px",
      "radius": "0",
      "bg": "var(--surface)",
      "border": "3px solid var(--line)",
      "font": "15.5px Jost",
      "focus": "outline 3px var(--accent)",
      "error": "border var(--accent) + 10px mono hata satırı",
      "disabled": "background var(--surface-2), opacity .55"
    },
    "card": {
      "padding": "24px",
      "radius": "0",
      "bg": "var(--surface)",
      "border": "3px solid var(--line)",
      "featured": "box-shadow var(--shadow-hard)"
    },
    "chip": {
      "height": "26px",
      "padding": "0 10px",
      "radius": "0",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)",
      "font": "10px/400 mono uppercase 0.16em",
      "active": "var(--accent) + var(--accent-ink)",
      "target": "min-height 44px padding ile"
    },
    "nav": {
      "height": "74px",
      "padding": "0 32px",
      "borderBottom": "3px solid var(--line)",
      "font": "12px/400 mono uppercase 0.12em",
      "active": "6px accent alt çizgi"
    },
    "tableRow": {
      "height": "54px",
      "padding": "14px 16px",
      "border": "1px solid rgba(17,16,15,.18) alt",
      "selected": "sol 6px accent",
      "hover": "background var(--surface-2)"
    },
    "modal": {
      "padding": "28px",
      "radius": "0",
      "border": "3px solid var(--line)",
      "shadow": "var(--shadow-hard)",
      "backdrop": "rgba(17,16,15,.62)",
      "close": "44×44"
    },
    "toast": {
      "height": "48px",
      "bg": "var(--ink)",
      "color": "var(--bg)",
      "accentBar": "6px var(--accent)",
      "duration": "4s"
    },
    "chart": {
      "series": "--data-1 accent, --data-2 ink, --data-3 ink-soft, --data-4 surface-2",
      "axis": "10px mono",
      "bars": "radius 0, 6px boşluk"
    }
  },
  "imagery": {
    "icons": "3px çizgi, 24px ızgara, geometrik",
    "photos": "yüksek kontrast siyah-beyaz veya kırmızı duotone; alan ≥%28, tek kare",
    "illustration": "yok — montaj fotoğraf + çubuk + harf bloğu ile kurulur",
    "texture": "grain .03 + 45° çizgi deseni (hero, opaklık ≤.08)",
    "logo": "Archivo Black kare monogram, 0 radius",
    "photo": "arch-02.jpg",
    "treatment": {
      "mode": "scrim",
      "strength": 0.3
