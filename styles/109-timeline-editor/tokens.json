{
  "slug": "timeline-editor",
  "num": "109",
  "name": "Zaman Çizelgesi Editörü",
  "version": 4,
  "css": "[data-style=\"timeline-editor\"] { --bg: #f1efec; --bg-2: #e7e3de; --surface: #fbfaf8; --surface-2: #f5f2ee; --ink: #1e1a17; --ink-soft: #554d46; --ink-faint: #857b71; --accent: #a12a6e; --accent-ink: #fff4f8; --line: rgba(30,26,23,.16); --radius: 4px; --radius-lg: 8px; --shadow: 0 2px 8px rgba(30,26,23,.12); --shadow-hard: none; --font-display: \"Archivo Black\", \"Inter\", system-ui, sans-serif; --font-body: \"Inter\", system-ui, sans-serif; --font-mono: \"IBM Plex Mono\", ui-monospace, monospace; --tracking: .01em; --blur: 0px; --grain: 2; --danger: #a8262c; --danger-ink: #ffffff; --ok: #1f6b3f; --warn: #7a5300; }",
  "palette": {
    "bg": "#f1efec",
    "bg2": "#e7e3de",
    "surface": "#fbfaf8",
    "surface2": "#f5f2ee",
    "ink": "#1e1a17",
    "inkSoft": "#554d46",
    "inkFaint": "#857b71",
    "accent": "#a12a6e",
    "accentInk": "#fff4f8",
    "line": "rgba(30,26,23,.16)",
    "dark": {
      "bg": "#121213",
      "bg2": "#171719",
      "surface": "#1d1c1f",
      "surface2": "#242327",
      "ink": "#efece7",
      "inkSoft": "#b7b0a8",
      "inkFaint": "#857f78",
      "accent": "#d97ac0",
      "accentInk": "#1c0508",
      "line": "rgba(239,236,231,.16)"
    }
  },
  "typography": {
    "display": "Archivo Black",
    "body": "Inter",
    "mono": "IBM Plex Mono",
    "scale": {
      "label": "10px",
      "caption": "11px",
      "small": "12px",
      "body": "14px",
      "h3": "18px",
      "h2": "26px",
      "h1": "38px",
      "h1Mobile": "24px"
    },
    "weights": {
      "body": 400,
      "strong": 600,
      "display": 400
    },
    "lineHeight": {
      "display": 1.1,
      "heading": 1.26,
      "body": 1.55
    },
    "tracking": {
      "display": "-.01em",
      "heading": "0",
      "body": "0",
      "label": ".08em"
    },
    "measure": "68ch",
    "forbidden": [
      "Serif display",
      "Dekoratif illüstrasyon",
      "Hap radius",
      "Yumuşak büyük gölge",
      "Orantılı (tabular olmayan) sayı"
    ]
  },
  "shape": {
    "radius": "4px",
    "radiusLg": "8px",
    "border": "1px solid var(--line)",
    "maxRadius": "8px"
  },
  "elevation": {
    "levels": [
      "bg",
      "surface",
      "overlay"
    ],
    "shadow": "0 2px 8px rgba(30,26,23,.12)",
    "shadowHard": "none",
    "rule": "Derinlik neredeyse yok: klipler 1px çerçeve + tek küçük gölge (0 2px 8px). Sürüklenen klip gölgeyi bir kademe büyütür (0 8px 20px); başka hiçbir öğe gölge taşımaz."
  },
  "spacing": {
    "unit": "4px",
    "scale": [
      "4px",
      "8px",
      "12px",
      "16px",
      "24px",
      "32px",
      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "48px",
      "mobile": "28px"
    },
    "cardPadding": "16px"
  },
  "grid": {
    "columns": 12,
    "gutter": "12px",
    "container": "1360px",
    "measure": "68ch",
    "breakpoints": {
      "sm": "390px",
      "md": "768px",
      "lg": "1360px"
    },
    "asymmetry": "iş alanı geniş (8 kolon), denetçi dar (4 kolon); kanal şeritleri tam genişlik — ekran başına 1 asimetrik bölünme"
  },
  "layout": {
    "hero": "sticky",
    "nav": "inline",
    "density": "balanced",
    "family": "Etkileşim"
  },
  "imagery": {
    "icons": "1.5px çizgi, 20px ızgara; oynat/kes/trim/mikser sembolleri",
    "photos": "medya küçük görseli (thumbnail) klip içinde, 4px radius kırpma, düşük doygunluk",
    "illustration": "yok; dalga formu (ses kanalı) ve klip blokları imza",
    "texture": "grain %2; kanal şeritlerinde 1px yatay çizgi deseni",
    "logo": "mono büyük harf wordmark + zaman kodu biçimi, 16px çevre boşluk",
    "photo": "int-02.jpg",
    "treatment": {
      "mode": "scrim",
      "strength": 0.4
    }
  },
  "components": {
    "button": {
      "height": "32px",
      "padding": "0 10px",
      "radius": "var(--radius)",
      "font": "11px/600 mono uppercase .08em",
      "bg": "var(--surface-2)",
      "color": "var(--ink)",
      "shadow": "none",
      "states": {
        "hover": "surface-2 %88 + ink",
        "active": "translateY(1px)",
        "focus": "outline 2px solid var(--accent), offset 2px",
        "disabled": "opacity .45, kesikli çerçeve",
        "loading": "playhead ilerleme çizgisi %0→%100 (600ms)"
      }
    },
    "buttonSecondary": {
      "height": "32px",
      "padding": "0 10px",
      "bg": "transparent",
      "border": "1px solid var(--line)",
      "color": "var(--ink-soft)"
    },
    "input": {
      "height": "32px",
      "padding": "0 10px",
      "radius": "var(--radius)",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "focus": "outline 2px solid var(--accent), offset 1px",
      "error": "border-color var(--danger) + 10px mono etiket"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "16px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "note": "denetçi paneli gölgesiz; klip gölge taşır"
    },
    "chip": {
      "height": "20px",
      "padding": "0 6px",
      "radius": "var(--radius)",
      "font": "10px/600 mono .08em",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)"
    },
    "nav": {
      "height": "44px",
      "padding": "0 16px",
      "borderBottom": "1px solid var(--line)",
      "note": "üst bar: proje adı mono + kaydetme durumu nokta"
    },
    "tableRow": {
      "height": "32px",
      "padding": "4px 8px",
      "border": "yok; kanal şeritleri 1px yatay çizgi"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "20px",
      "border": "1px solid var(--accent)",
      "shadow": "0 8px 20px rgba(30,26,23,.18)",
      "note": "dışa aktarma; süre ve codec mono"
    },
    "toast": {
      "height": "32px",
      "padding": "6px 10px",
      "radius": "var(--radius)",
      "duration": "3000ms, sağ-alt",
      "note": "sol uçta 2px accent playhead çizgisi"
    },
    "chart": {
      "series": "var(--accent), var(--ok), var(--warn), var(--danger)",
      "maxSeries": 4,
      "note": "kanal dalga formu 1.5px, klip blokları dolgu %14"
    }
  },
  "motion": {
    "fast": "110ms",
    "base": "220ms",
    "slow": "530ms",
    "easing": "cubic-bezier(.45,.08,.25,1)",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms (tokens.css global) — playhead ve pin statik kalır",
    "forbidden": [
      "Akan playhead animasyonu (kayıt dışında)",
      "Yay/overshoot",
      "Blur geçişi",
      "Saniyede 3 üstü flash"
    ],
    "family": "Etkileşim",
    "sequences": {
      "enter": {
        "duration": "0.51s",
        "ease": "cubic-bezier(.45,.08,.25,1)",
        "offsetY": "15px",
        "stagger": "0.042"
      },
      "scroll": {
        "trigger": "top 67%",
        "duration": "0.53s",
        "offsetY": "18px",
        "once": true
      },
      "pin": {
        "enabled": true,
        "scrub": 1.3,
        "distance": "+190%"
      },
      "hover": {
        "duration": "165ms",
        "imageScale": "1.004"
      }
    },
    "choreography": {
      "enter": "fade-rise",
      "scroll": "pin-scrub",
      "hover": "scale",
      "page": "crossfade",
      "reduced": "static-frame"
    }
  },
  "must": [
    "Kanallar 32px şerit yüksekliğinde; zaman kodu mono ve tabular (00:00:12:04)",
    "Playhead tek dikey çizgi (2px accent) ve sürüklenebilir; ikinci imleç yok",
    "Klip blokları 1px çerçeve + %14 kanal tonu; seçili klip accent %24 dolgu",
    "Izgara ve cetvel 1px; ana kare (sn) çizgileri daha koyu, ara çizgiler %50 opak",
    "Gölge yalnız sürüklenen klipte; diğer yüzeyler düz",
    "Klavye kısayolları zorunlu: boşluk oynat/durdur, J/K/L trim, I/O işaretle"
  ],
  "mustNot": [
    "Serif display ve dekoratif illüstrasyon",
    "Hap radius, yumuşak büyük gölge",
    "Orantılı sayı / hizasız zaman kodu",
    "Akan playhead (yalnız oynatma sırasında)",
    "Renk-only kanal ayrımı (kanal adı yazılır)",
    "Blur ve cam yüzey"
  ],
  "neighbors": {
    "compatible": [
      "kinetic-type",
      "utility",
      "log-stream"
    ],
    "forbidden": [
      "claymorphism",
      "memphis"
    ]
  },
