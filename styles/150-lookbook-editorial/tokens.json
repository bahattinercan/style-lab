      "padding": "8px 12px",
      "radius": "var(--radius)",
      "font": "11px/400 JetBrains Mono",
      "duration": "3600ms",
      "note": "sol 3px kiremit şerit; sağ üst, üst üste 2"
    },
    "chart": {
      "series": "var(--ink), var(--accent), var(--ink-faint)",
      "maxSeries": 3,
      "note": "çizgi 1.5px, alan dolgusu yok; ızgara 1px --line"
    }
  },
  "motion": {
    "fast": "110ms",
    "base": "280ms",
    "slow": "700ms",
    "easing": "cubic-bezier(.4,0,.15,1) — kâğıt üzerinde kayma: sabit hız, sert duruş",
