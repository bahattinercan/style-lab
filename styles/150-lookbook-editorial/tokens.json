        "focus": "outline 2px solid var(--accent), offset 2px"
      }
    },
    "input": {
      "height": "52px",
      "padding": "0 0",
      "radius": "0",
      "bg": "transparent",
      "border": "0 0 1px 0 solid var(--line)",
      "font": "17px/400 Inter",
      "focus": "border-bottom 1px solid var(--accent), outline yok",
