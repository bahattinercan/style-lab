      "mode": "plain",
      "strength": 0
    }
  },
  "components": {
    "button": {
      "height": "44px",
      "padding": "12px 20px",
      "radius": "2px",
      "font": "15px/400 body, .04em",
      "bg": "transparent",
      "color": "var(--accent)",
      "border": "1px solid var(--accent)",
      "shadow": "none",
      "states": {
        "hover": "bg var(--accent), color var(--accent-ink), 380ms",
        "active": "opacity .9",
        "focus": "outline 2px var(--accent), offset 3px",
        "disabled": "opacity .4",
        "loading": "metin + \"…\""
      }
    },
    "buttonSecondary": {
      "height": "44px",
      "padding": "12px 20px",
      "radius": "2px",
      "font": "15px/400 body",
      "bg": "transparent",
      "color": "var(--ink)",
      "border": "1px solid var(--line)",
      "states": {
        "hover": "border-color var(--ink-soft)"
      }
    },
    "input": {
      "height": "44px",
      "padding": "11px 12px",
      "radius": "2px",
      "font": "16.5px/400 body",
      "bg": "transparent",
      "border": "alt 1px solid var(--line)",
      "states": {
        "focus": "alt kenar 1px var(--accent)",
        "filled": "bg var(--bg-2)",
        "error": "alt kenar 1px var(--accent) + 12.5px hata",
        "disabled": "opacity .5"
      }
    },
    "card": {
      "padding": "24px",
      "radius": "8px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "states": {
        "hover": "border-color var(--ink-soft)"
      }
    },
    "chip": {
      "height": "22px",
      "padding": "2px 8px",
      "radius": "2px",
      "font": "10.5px/400 mono, .18em uppercase",
      "bg": "transparent",
      "border": "1px solid var(--line)",
      "states": {
        "active": "border-color var(--accent), color var(--accent)"
      }
    },
    "nav": {
      "height": "64px",
      "padding": "0 28px",
      "border": "alt 1px solid var(--line)",
      "font": "10.5px/400 mono, .18em uppercase",
      "states": {
        "active": "color var(--accent)",
        "pasif": "color var(--ink-soft)"
      }
    },
    "tableRow": {
      "height": "48px",
      "padding": "0 10px",
      "border": "alt 1px solid var(--line)",
      "font": "16.5px/400 body",
      "states": {
        "hover": "bg var(--bg-2)",
        "secili": "bg var(--surface-2)"
      }
    },
    "modal": {
      "width": "460px",
      "padding": "28px",
      "radius": "8px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "states": {
        "backdrop": "rgba(34,32,29,.40)"
      }
    },
    "toast": {
      "height": "40px",
      "padding": "10px 16px",
      "radius": "2px",
      "bg": "var(--ink)",
      "color": "var(--bg)",
      "font": "12.5px/400 body",
      "states": {
        "show": "opacity 0→1, 300ms"
      }
    },
    "chart": {
      "series": "1 (accent)",
      "stroke": "1px",
      "fill": "yok",
      "grid": "yok",
      "states": {
        "legend": "mono 10.5px .18em"
      }
    }
  },
  "motion": {
    "fast": "160ms",
    "base": "300ms",
    "slow": "520ms",
    "easing": "cubic-bezier(.33,1,.68,1)",
