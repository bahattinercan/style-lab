      "height": "32px",
      "padding": "0 12px",
      "radius": "var(--radius)",
      "font": "13px/600 body",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "accent %88 + ink, tuş ipucu görünür",
        "active": "translateY(2px), gölge sıfırlanır",
        "focus": "outline 2px solid var(--accent), offset 2px",
        "disabled": "opacity .35, tuş ipucu köşeli parantez içinde soluk",
        "loading": "`…` + komut satırında `çalışıyor` mono satırı"
      }
    },
    "buttonSecondary": {
      "height": "32px",
      "padding": "0 12px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "color": "var(--ink)"
    },
    "input": {
      "height": "34px",
      "padding": "0 10px",
      "radius": "var(--radius)",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "focus": "border-color var(--accent) + outline 2px accent %30, offset 1px; satır başında `>` işareti",
      "error": "border-color var(--danger) + `hata:` önekli mono satır"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "14px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "note": "kart: başlık satırında solda `⌘K` tuş başlığı, sağda tek mono meta; gölge yok"
    },
    "chip": {
      "height": "20px",
      "padding": "0 6px",
      "radius": "var(--radius)",
      "font": "11px/500 mono",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)"
    },
    "nav": {
      "height": "44px",
      "padding": "0 16px",
      "borderBottom": "1px solid var(--line)",
      "note": "navda komut satırı girişi + sağda `/` ve `?` tuş başlıkları"
    },
    "tableRow": {
      "height": "30px",
      "padding": "4px 8px",
      "border": "yok; satır arası 1px var(--line)"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "16px",
      "border": "1px solid var(--line)",
      "shadow": "0 14px 34px rgba(0,0,0,.5)",
      "note": "komut listesi: satır başına tuş başlığı, seçili satır accent sol 2px şerit"
    },
    "toast": {
      "height": "30px",
      "padding": "6px 10px",
      "radius": "var(--radius)",
      "duration": "2600ms, sağ alt",
      "note": "komut çıktısı tek satır mono; `Esc` ile kapanır ipucu taşır"
    },
    "chart": {
      "series": "var(--accent), var(--ink-soft), var(--warn)",
      "maxSeries": 3,
      "note": "grafik yalnız özet panelinde: 1.5px çizgi, ızgara hairline"
    }
