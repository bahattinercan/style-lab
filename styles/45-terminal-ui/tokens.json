{
  "slug": "terminal-ui",
  "num": "45",
  "name": "Terminal UI",
  "version": 4,
  "css": "[data-style=\"terminal-ui\"] { --bg: #0a0d0a; --bg-2: #0d110d; --surface: #0f140f; --surface-2: #131a13; --ink: #d7e6d2; --ink-soft: #9bb394; --ink-faint: #6d8268; --accent: #58e08a; --accent-ink: #04120a; --line: rgba(215,230,210,.16); --radius: 0px; --radius-lg: 2px; --shadow: none; --shadow-hard: none; --font-display: \"JetBrains Mono\", ui-monospace, monospace; --font-body: \"JetBrains Mono\", ui-monospace, monospace; --font-mono: \"JetBrains Mono\", ui-monospace, monospace; --tracking: 0em; --blur: 0px; --grain: 0; --danger: #ff6b6b; --danger-ink: #0a0d0a; --ok: #58e08a; --warn: #e0c058; }",
  "palette": {
    "bg": "#0a0d0a",
