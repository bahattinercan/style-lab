      "surface": "#0b0f0b",
      "surface2": "#101510",
      "ink": "#e6f1e2",
      "inkSoft": "#a8bda2",
      "inkFaint": "#78896f",
      "accent": "#6ff09c",
      "accentInk": "#03150a",
      "line": "rgba(230,241,226,.18)"
    }
  },
  "typography": {
    "display": "JetBrains Mono",
    "body": "JetBrains Mono",
    "mono": "JetBrains Mono",
    "scale": {
      "label": "11px",
      "caption": "12px",
