    },
    "measure": "72ch",
    "forbidden": [
      "Serif veya geometrik display font",
      "16px üzeri radius (kutu dili)",
      "Yumuşak/yayılan gölge",
      "İtalik",
      "Karışık genişlik (tek mono aile)"
    ]
  },
  "shape": {
    "radius": "0px",
    "radiusLg": "2px",
    "border": "1px solid var(--line)",
    "maxRadius": "2px"
  },
  "elevation": {
    "levels": [
      "bg",
      "surface",
      "overlay"
    ],
    "shadow": "none",
    "shadowHard": "none",
    "rule": "Derinlik yok: katman ayrımı 1px çerçeve + ters video (accent zemin) ile. Gölge, blur, gradient yasak."
  },
  "spacing": {
    "unit": "4px",
    "scale": [
      "4px",
      "8px",
      "12px",
      "16px",
      "24px",
      "32px",
      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "64px",
      "mobile": "40px"
    },
    "cardPadding": "16px"
  },
  "grid": {
    "columns": 12,
    "gutter": "16px",
    "container": "1180px",
    "measure": "72ch",
    "breakpoints": {
      "sm": "390px",
      "md": "768px",
      "lg": "1200px"
    },
    "asymmetry": "ızgara görünür karakter değil; asimetri yerine hizalama kesinliği"
  },
  "layout": {
    "hero": "product",
    "nav": "utility",
    "density": "dense",
    "family": "Teknik"
  },
  "imagery": {
    "icons": "tek çizgi (1px) ASCII-benzeri ikon veya Phosphor \"thin\"; dolu ikon yok",
    "photos": "yok — ekran görüntüsü yerine metin/tablo; zorunluysa 1px çerçeve içinde, doygunluğu düşük",
    "illustration": "ASCII diyagram (kutu çizimi, ok, ağaç)",
    "texture": "yok (--grain: 0); tarama çizgisi/CRT efekti yasak",
    "logo": "metin logo (mono, küçük harf veya büyük harf tek biçim)",
    "photo": "urb-02.jpg",
    "treatment": {
      "mode": "scrim",
      "strength": 0.5
    }
  },
  "components": {
    "button": {
      "height": "36px",
      "padding": "6px 12px",
      "radius": "var(--radius)",
      "font": "13px/600 mono",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "accent %88 + ink karışımı",
        "active": "translateY(1px)",
        "focus": "outline 1px solid var(--accent), offset 2px",
        "disabled": "opacity .45, kesikli çerçeve",
        "loading": "satır içi [....] animasyonu, 4 kare"
      }
    },
    "buttonSecondary": {
      "height": "36px",
      "padding": "6px 12px",
      "bg": "transparent",
      "border": "1px solid var(--line)",
      "color": "var(--ink)"
    },
    "input": {
      "height": "36px",
      "padding": "0 10px",
      "radius": "var(--radius)",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "focus": "outline 1px solid var(--accent), offset 1px; imleç accent",
      "error": "border-color var(--danger) + `! ` öneki + açıklama"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "16px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none"
    },
    "chip": {
      "height": "20px",
      "padding": "0 6px",
      "radius": "var(--radius)",
      "font": "11px/500 mono",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)"
    },
    "nav": {
      "height": "40px",
      "padding": "0 16px",
      "borderBottom": "1px solid var(--line)",
      "note": "üst bar tek satır; aktif öğe `> ` öneki ve accent metin"
    },
    "tableRow": {
      "height": "32px",
      "padding": "4px 8px",
      "border": "yok; sütun hizası boşlukla"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "16px",
      "border": "1px solid var(--accent)",
      "shadow": "none",
      "note": "modal çerçevesi accent; başlık satırı `┌─ başlık ─┐` hissi"
    },
    "toast": {
      "height": "28px",
      "padding": "4px 10px",
      "radius": "var(--radius)",
      "duration": "3000ms, alt satırda (status line)",
      "note": "toast yerine durum satırı tercih edilir"
    },
    "chart": {
      "series": "var(--accent), var(--ink-soft), var(--warn), var(--danger)",
      "maxSeries": 4,
      "note": "grafik yerine sparkline (blok karakter) veya tablo"
    }
  },
  "motion": {
    "fast": "90ms",
    "base": "180ms",
    "slow": "300ms",
    "easing": "steps(2, end) / linear",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms (tokens.css global) — imleç yanıp sönmesi durur",
    "forbidden": [
      "Yay/ease-out yumuşaklığı (terminal kesik hareket eder)",
      "Parallax",
      "Sürekli döngü (imleç dışında)",
      "Gradient geçişi"
    ],
    "family": "Teknik",
    "sequences": {
      "enter": {
        "duration": "0.18s",
        "ease": "steps(3, end)",
        "offsetY": "0px",
        "stagger": "0.03"
      },
      "scroll": {
        "trigger": "top 90%",
        "duration": "0.2s",
        "offsetY": "8px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "90ms",
        "imageScale": "1.000"
      }
    },
    "choreography": {
      "enter": "scale-settle",
      "scroll": "scroll-zoom",
      "hover": "scale",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "must": [
    "Tek aile: JetBrains Mono; display = body = mono",
    "Ölçü her yerde sayısal ve hizalı (karakter ızgarası)",
    "Katman ayrımı 1px çerçeve; gölge/blur yok",
    "Durum metinle bildirilir (`[ok]`, `> `, `! `), yalnız renkle değil",
    "Klavye ile tam gezinti: Tab sırası görünür, kısayol ipuçları gösterilir",
    "Yoğunluk: satır yüksekliği 32px, tablo hücresi 4/8px padding"
  ],
  "mustNot": [
    "Yumuşak gölge, yuvarlak kart, gradient zemin",
    "Süsleme amaçlı ikon veya illüstrasyon",
    "Serif/geometrik display font",
    "CRT tarama çizgisi, flicker, sürekli yanıp sönen öğe (imleç hariç)",
    "16px üzeri radius",
    "Anlaşılmaz kısaltma: jargon yalnız ekranda tanımlıysa"
  ],
