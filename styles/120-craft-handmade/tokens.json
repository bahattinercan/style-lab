  "version": 4,
  "css": "[data-style=\"craft-handmade\"] { --bg: #efe6d6; --bg-2: #e5dac6; --surface: #f9f3e7; --surface-2: #e9dfcb; --ink: #2a231a; --ink-soft: #574c3d; --ink-faint: #857a68; --accent: #7a4b2a; --accent-ink: #fbf5ea; --line: rgba(42,35,26,.20); --radius: 4px; --radius-lg: 10px; --shadow: none; --shadow-hard: none; --font-display: \"Caveat\", \"Kalam\", cursive; --font-body: \"Nunito\", system-ui, sans-serif; --font-mono: \"IBM Plex Mono\", ui-monospace, monospace; --tracking: 0.01em; --blur: 0px; --grain: 0.04; }",
