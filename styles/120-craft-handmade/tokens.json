    ]
  },
  "shape": {
    "radius": "4px",
    "radiusLg": "10px",
    "border": "1px solid var(--line)",
    "rule": "Radius 4px (buton/input/chip) ve 10px (kart/modal); 12px üstü yasak; dikiş çizgisi düz (radius yok); avatar 50%."
  },
  "elevation": {
    "levels": [
      "bg",
      "surface",
      "overlay"
    ],
    "shadow": "none",
    "shadowHard": "none",
    "rule": "Gölge yok; derinlik kâğıt ton kademesi, %4 kraft dokusu ve 1px kesikli dikişten gelir. Yüzen modal bile 1px kenar ile ayrılır."
  },
  "spacing": {
    "unit": "4px",
    "scale": [
      "4px",
      "8px",
      "12px",
      "16px",
      "24px",
      "32px",
      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "96px",
      "mobile": "56px"
    },
    "cardPadding": "24px"
  },
  "grid": {
    "columns": 12,
    "gutter": "24px",
    "container": "1080px",
    "measure": "48ch",
    "breakpoints": {
      "sm": "390px",
      "md": "768px",
      "lg": "1200px"
    },
    "asymmetry": "Ürün 7/12, hikâye 4/12; ekran başına 1 asimetrik blok ve 1 dikiş çizgisi."
  },
  "layout": {
    "hero": "fullbleed",
    "nav": "pill",
    "density": "dense",
    "family": "Oyuncul"
  },
  "imagery": {
    "icons": "1.5px çizgi, yuvarlak uç, 20px ızgara; ikon el çizimi hissi (hafif 1° eğim)",
    "photos": "Ürün fotoğrafı: doğal ışık, kumaş/ahşap doku, alan ≤%45; sepya filtre yok",
    "illustration": "Yok — ürün fotoğrafı ve el yazısı yeterli",
    "texture": "Kraft grain %4 (overlay, pointer-events none) + 1px/7px yatay kâğıt çizgisi %3",
    "logo": "Sol üst 24px, Caveat 700 24px; sembol yok",
    "photo": "obj-02.jpg",
    "treatment": {
      "mode": "duotone",
      "strength": 0.3
    }
  },
  "components": {
    "button": {
      "height": "48px",
      "padding": "13px 22px",
      "radius": "4px",
      "font": "15px/700 body, .02em",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "translateY(-1px) + kenar 1px var(--ink)",
        "active": "translateY(1px)",
        "focus": "outline 2px var(--accent), offset 3px",
        "disabled": "opacity .45",
        "loading": "etiket şeridi 2px dolar"
      }
    },
    "buttonSecondary": {
      "height": "48px",
      "padding": "13px 22px",
      "radius": "4px",
      "font": "15px/400 body",
      "bg": "transparent",
      "color": "var(--ink)",
      "border": "1px solid var(--line)",
      "states": {
        "hover": "kenar 1px var(--ink)"
      }
    },
    "input": {
      "height": "48px",
      "padding": "12px 14px",
      "radius": "4px",
      "font": "16.5px/400 body",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "states": {
        "focus": "outline 2px var(--accent), offset 2px",
        "filled": "bg var(--surface-2)",
        "error": "kenar 1px var(--accent) + 13px mesaj",
        "disabled": "opacity .5"
      }
    },
    "card": {
      "padding": "24px",
      "radius": "10px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "states": {
        "hover": "kenar 1px var(--ink-soft)"
      }
    },
    "chip": {
      "height": "26px",
      "padding": "4px 9px",
      "radius": "4px",
      "font": "12.5px/400 mono, .14em uppercase",
      "bg": "var(--bg-2)",
      "border": "1px solid var(--line)",
      "states": {
        "aktif": "bg var(--accent), color var(--accent-ink)"
      }
    },
    "nav": {
      "height": "64px",
      "padding": "0 28px",
      "border": "alt 1px solid var(--line)",
      "font": "13px/400 mono, .14em uppercase",
      "states": {
        "active": "color var(--accent)",
        "pasif": "color var(--ink-soft)"
      }
    },
    "tableRow": {
      "height": "52px",
      "padding": "0 12px",
      "border": "alt 1px solid var(--line)",
      "font": "16.5px/400 body + 12.5px mono fiyat",
      "states": {
        "hover": "bg var(--bg-2)",
        "secili": "bg var(--surface-2)"
      }
    },
    "modal": {
      "width": "480px",
      "padding": "28px",
      "radius": "10px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "states": {
        "backdrop": "rgba(42,35,26,.45)"
      }
    },
    "toast": {
      "height": "44px",
      "padding": "12px 16px",
      "radius": "4px",
      "bg": "var(--ink)",
      "color": "var(--bg)",
      "font": "13px/400 body",
      "states": {
        "show": "translateY(6px) + opacity, 300ms"
      }
    },
    "chart": {
      "series": "2 (accent, ink-soft)",
      "stroke": "2px",
      "fill": "accent %6",
      "grid": "1px dashed var(--line)",
      "states": {
        "legend": "12.5px mono .14em"
      }
    }
  },
  "motion": {
    "fast": "160ms",
    "base": "300ms",
    "slow": "520ms",
    "easing": "cubic-bezier(.4,.1,.3,1)",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms — pin/scrub kapalı, dikiş statik",
    "forbidden": [
      "ikinci scrub",
      "parallax",
      "marquee",
      "sürekli döngü",
      "spring/overshoot",
      "blur geçişi"
    ],
    "family": "Oyuncul",
    "sequences": {
      "enter": {
        "duration": "0.82s",
        "ease": "cubic-bezier(.4,.1,.3,1)",
        "offsetY": "26px",
        "stagger": "0.09"
      },
      "scroll": {
        "trigger": "top 79%",
        "duration": "0.95s",
        "offsetY": "22px",
        "once": true
      },
      "pin": {
        "enabled": true,
        "scrub": "1.1",
        "distance": "+120%"
      },
      "hover": {
        "duration": "300ms",
        "imageScale": "1.02"
      }
    },
    "choreography": {
      "enter": "split-slide",
      "scroll": "parallax",
      "hover": "scale",
      "page": "crossfade",
      "reduced": "static-frame"
    }
  },
  "must": [
    "Caveat 700 52px/1.08 başlık (mobil 32px); gövde Nunito 16.5px/1.72/48ch",
    "Sol kenarda 2px dashed dikiş çizgisi, ekran başına 1 (mobilde 1px)",
    "Kraft grain %4 + 1px/7px yatay kâğıt çizgisi %3; ikinci doku yok",
    "Tek accent taba #7a4b2a, ekranın ≤%7'si, accent üstü daima --accent-ink",
    "Gölge yok; radius 4/10px; ayrım 1px hairline + doku",
    "Bölüm arası 96px (mobil 56px), kart içi 24px; ölçek 4·8·12·16·24·32·48·64",
    "Tek pin sahnesi: üretim adımları, scrub 1.1, +120%, mobilde statik",
    "Fiyat/ölçü IBM Plex Mono 12.5px; etiketler uppercase .14em"
  ],
  "mustNot": [
    "Sepya/vintage fotoğraf filtreleri, gradyan, parlak metalik, iki sıcak renk",
    "Gölge, blur, cam yüzey; 12px üstü radius",
    "Kolaj, rastgele rotasyon, sticker patlaması, emoji süs",
    "İkinci scrub, pin'in mobilde açık bırakılması, marquee, sürekli döngü",
    "Gövdede el yazısı font (Caveat yalnız başlıkta), 16.5px altı gövde",
    "Saf beyaz zemin, saf siyah metin, filter: invert()"
  ],
