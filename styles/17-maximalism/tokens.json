{
  "slug": "maximalism",
  "num": "17",
  "name": "Maximalism",
  "version": 4,
  "css": "[data-style=\"maximalism\"] { --bg: #f6e7d8; --bg-2: #e8cfae; --surface: #fffaf3; --surface-2: #f2c14e; --ink: #221410; --ink-soft: #57403a; --ink-faint: #8f7a72; --accent: #7a1f3d; --accent-ink: #f6e7d8; --line: rgba(34,20,16,.2); --radius: 6px; --radius-lg: 14px; --shadow: 6px 6px 0 rgba(34,20,16,.85); --shadow-hard: none; --font-display: \"Playfair Display\", \"Fraunces\", Georgia, serif; --font-body: \"Inter\", system-ui, sans-serif; --font-mono: \"Space Mono\", ui-monospace, monospace; --tracking: -0.01em; --blur: 0px; --grain: .05; --focus: #7a1f3d;\n}",
  "palette": {
    "bg": "#f6e7d8",
    "bg2": "#e8cfae",
    "surface": "#fffaf3",
    "surface2": "#f2c14e",
    "ink": "#221410",
    "inkSoft": "#57403a",
    "inkFaint": "#8f7a72",
    "accent": "#7a1f3d",
    "accentInk": "#f6e7d8",
    "line": "rgba(34,20,16,.2)",
    "dark": {
      "bg": "#1a1310",
      "bg2": "#27201c",
      "surface": "#241a15",
      "surface2": "#c79b33",
      "ink": "#f6e7d8",
      "inkSoft": "#b4a79c",
      "inkFaint": "#7d726a",
      "accent": "#a8385a",
      "accentInk": "#ffffff",
      "line": "rgba(246,231,216,.14)"
    }
  },
  "typography": {
    "display": "Playfair Display",
    "body": "Inter",
    "mono": "Space Mono",
    "scale": {
      "label": "10px",
      "caption": "13px",
      "small": "15px",
      "body": "16px",
      "quote": "22px",
      "h2": "40px",
      "h1": "68px",
      "h1Mobile": "36px"
    },
    "weights": {
      "body": 400,
      "strong": 600,
      "display": 700
    },
    "lineHeight": {
      "display": 1,
      "heading": 1.05,
      "body": 1.6,
      "quote": 1.4
    },
    "tracking": {
      "display": "-0.01em",
      "heading": "-0.01em",
      "body": "0",
      "label": "0.18em"
    },
    "measure": "58ch",
    "maxScaleSteps": 3
  },
  "shape": {
    "radius": "6px",
    "radiusLg": "14px",
    "border": "2px solid var(--ink)"
  },
  "elevation": {
    "levels": [
      "desenli bant",
      "kart (6px ofset)",
      "yüzen (10px ofset)"
    ],
    "shadow": "6px 6px 0 rgba(34,20,16,.85)",
    "shadowHard": "none",
    "rule": "Derinlik ofsetten; blur yok"
  },
  "motion": {
    "fast": "120ms",
    "base": "240ms",
    "slow": "360ms",
    "easing": "ease-out / cubic-bezier(.2,.6,.2,1)",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "motif animasyonu kapalı",
    "forbidden": [
      "aynı anda 3+ öğe hareketi",
      "sürekli desen animasyonu"
    ],
    "family": "Cesur",
    "sequences": {
      "enter": {
        "duration": "0.42s",
        "ease": "cubic-bezier(.2,.6,.2,1)",
        "offsetY": "20px",
        "stagger": "0.06"
      },
      "scroll": {
        "trigger": "top 84%",
        "duration": "0.5s",
        "offsetY": "16px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "140ms",
        "imageScale": "1.03"
      }
    },
    "choreography": {
      "enter": "split-slide",
      "scroll": "parallax",
      "hover": "underline-draw",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "spacing": {
    "unit": "8px",
    "scale": [
      "8px",
      "16px",
      "24px",
      "32px",
      "48px",
      "72px"
    ],
    "sectionY": {
      "desktop": "72px",
      "mobile": "48px"
    },
    "cardPadding": "24px"
  },
  "grid": {
    "columns": 12,
    "gutter": "24px",
    "container": "1200px",
    "breakpoints": {
      "sm": "640px",
      "md": "900px",
      "lg": "1200px"
    },
    "rhythm": "tam genişlik bant → dar içerik → hardal blok"
  },
  "layout": {
    "hero": "split-reverse",
    "nav": "inline",
    "density": "dense",
    "family": "Cesur"
  },
  "components": {
    "button": {
      "height": "50px",
      "padding": "0 24px",
      "radius": "var(--radius)",
      "font": "15px/600",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "4px 4px 0 rgba(34,20,16,.85)",
      "states": {
        "hover": "translate(4px,4px) + shadow 0",
        "focus": "outline 3px var(--ink)",
        "disabled": "opacity .40"
      }
    },
    "buttonMustard": {
      "height": "50px",
      "bg": "var(--surface-2)",
      "color": "var(--ink)",
      "border": "2px solid var(--ink)"
    },
    "input": {
      "height": "50px",
      "padding": "0 16px",
      "radius": "var(--radius)",
      "border": "2px solid var(--ink)",
      "focus": "outline 2px var(--accent)"
    },
    "card": {
      "padding": "24px",
      "radius": "var(--radius-lg)",
      "border": "2px solid var(--ink)",
      "shadow": "var(--shadow)"
    },
    "chip": {
      "height": "26px",
      "padding": "0 10px",
      "radius": "6px",
      "bg": "hardal %22",
      "border": "1px solid var(--ink)"
    },
    "nav": {
      "height": "76px",
      "padding": "0 32px",
      "pattern": "desenli bant",
      "borderBottom": "2px solid var(--ink)"
    },
    "tableRow": {
      "height": "54px",
      "padding": "12px 16px",
      "border": "2px solid var(--ink) alt"
    },
    "modal": {
      "padding": "28px",
      "radius": "var(--radius-lg)",
      "shadow": "10px 10px 0 rgba(34,20,16,.85)",
      "backdrop": "rgba(34,20,16,.45)"
    },
    "toast": {
      "height": "50px",
      "radius": "var(--radius)",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)"
    },
    "chart": {
      "series": "accent + surface-2 + ink çerçeve",
      "axis": "10px mono"
    }
  },
  "imagery": {
    "icons": "2px çizgi, 24px, çerçeveli",
    "photos": "zengin renk, dokulu, 14px radius, kalın çerçeve",
    "illustration": "gravür/çiçek motifi, çok renkli",
    "texture": "grain .05 + 1 desen katmanı (opacity .08–.12)",
    "logo": "serif wordmark, çerçeveli",
    "photo": "obj-03.jpg",
    "treatment": {
      "mode": "duotone",
      "strength": 0.35
    }
  },
  "must": [
    "Motif bütçesi: 1 baskın + ≤ 1 ikincil desen",
    "Metin asla desen üstünde",
    "Analog palet (bordo/hardal/krem); ≤ 3 doygun renk",
    "Serif display (Playfair) + sans gövde",
    "6px blur'suz ofset gölge, radius 6/14px",
    "Ekran başına tek odak ve ≤ 3 punto seviyesi"
  ],
  "mustNot": [
    "Desen üstünde metin",
    "3+ desen / her bölümde farklı stil",
    "Neon + pastel karışımı",
    "Farklı gölge ofsetleri",
    "Yoğun veri ekranında motif",
    "8 eşit kart ızgarası"
  ],
  "neighbors": {
