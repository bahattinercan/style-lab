        "active": "gölge yok, translate(0,0)",
        "focus": "outline 3px solid var(--accent); offset 0",
        "disabled": "opacity .4, 3px kesikli kenar",
        "loading": "mono `...` üç kare, 300ms adım"
      }
    },
    "buttonSecondary": {
      "height": "46px",
      "padding": "12px 20px",
      "bg": "var(--surface)",
      "border": "3px solid var(--ink)",
      "color": "var(--ink)",
      "states": {
        "hover": "background: var(--surface-2) + sert gölge",
        "focus": "outline 3px solid var(--accent); offset 0"
      }
    },
    "input": {
      "height": "46px",
      "padding": "0 12px",
      "radius": "2px",
      "bg": "var(--surface)",
      "border": "3px solid var(--ink)",
      "focus": "outline 3px solid var(--accent); offset 0",
      "error": "border-color var(--accent) + mono açıklama + `!` işareti"
    },
    "card": {
      "radius": "var(--radius)",
      "padding": "18px",
      "bg": "var(--surface)",
      "border": "3px solid var(--ink)",
      "shadow": "none",
      "note": "panel = çerçeve; bitişik paneller arasında 6px mürekkep oluk"
    },
    "chip": {
      "height": "22px",
      "padding": "3px 6px",
      "radius": "2px",
      "font": "10px/400 mono, .1em",
      "bg": "var(--ink)",
      "border": "0",
      "note": "ters video (koyu zemin + açık metin); accent varyantı efekt rengi"
    },
    "nav": {
      "height": "54px",
      "padding": "0 32px",
      "borderBottom": "3px solid var(--ink)",
      "note": "uppercase mono bağlantılar; aktif öğe 4px accent alt blok"
    },
    "tableRow": {
      "height": "40px",
      "padding": "8px 10px",
      "border": "alt 2px var(--line); dış çerçeve 3px var(--ink)",
      "note": "bölüm listesi: kare no (mono), başlık (Baloo), sayfa (mono)"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "24px",
      "border": "3px solid var(--ink)",
      "shadow": "var(--shadow-hard)",
