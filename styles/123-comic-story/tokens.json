    },
    "toast": {
      "height": "42px",
      "padding": "10px 14px",
      "radius": "8px",
      "bg": "var(--ink)",
      "color": "var(--bg)",
      "duration": "2600ms",
      "note": "balon biçimli: sol altta 8px kuyruk, mono metin"
    },
    "chart": {
      "series": "var(--accent), var(--ink)",
      "maxSeries": 2,
      "note": "el çizimi sütun veya kaba blok; 3px mürekkep çerçeve, yarım ton dolgu"
    }
  },
