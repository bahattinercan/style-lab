      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "64px",
      "mobile": "40px"
    },
    "cardPadding": "20px"
  },
  "grid": {
    "columns": 12,
    "gutter": "24px",
    "container": "1080px",
    "measure": "72ch",
    "breakpoints": {
      "sm": "390px",
      "md": "768px",
      "lg": "1200px"
    },
    "asymmetry": "Ana metin 8 kolon, kenar notu 3 kolon, 1 kolon boşluk; ekran başına 1 kenar notu."
  },
  "layout": {
    "hero": "type",
    "nav": "inline",
    "density": "sparse",
    "family": "Yayın & Tipografi"
  },
  "imagery": {
    "icons": "1.5px çizgi, 16px ızgara, kare uç; matematik sembolleri metin olarak (ikon değil)",
    "photos": "Yok — istisna: figür olarak 1 diyagram veya tablo",
    "illustration": "Yalnız veri grafiği/diyagram: 1px çizgi, dolgu yok, 2 seri",
    "texture": "Yok (`--grain: 0`); zemin düz",
    "logo": "Kurum adı sol üst 16px boşluk; mono 11px uppercase .08em",
    "photo": "int-01.jpg",
    "treatment": {
      "mode": "plain",
      "strength": 0
    }
  },
  "components": {
    "button": {
      "height": "44px",
      "padding": "11px 18px",
      "radius": "2px",
      "font": "14px/600 body",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "bg var(--ink), 120ms",
        "active": "opacity .9",
        "focus": "outline 2px var(--accent), offset 2px",
        "disabled": "opacity .45",
        "loading": "metin + \"…\""
      }
    },
    "buttonSecondary": {
      "height": "44px",
      "padding": "11px 18px",
      "radius": "2px",
      "font": "14px/400 body",
      "bg": "transparent",
      "color": "var(--ink)",
      "border": "1px solid var(--line)",
      "states": {
        "hover": "border-color var(--ink)"
      }
    },
    "input": {
      "height": "44px",
      "padding": "11px 12px",
      "radius": "2px",
      "font": "15.5px/400 body",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "states": {
        "focus": "border 1px var(--ink) + outline 2px var(--accent)",
        "filled": "bg var(--bg-2)",
        "error": "border 1px var(--accent) + 12.5px hata",
        "disabled": "opacity .5"
      }
    },
    "card": {
      "padding": "20px",
      "radius": "4px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "states": {
        "hover": "border-color var(--ink-soft)"
      }
    },
    "chip": {
      "height": "24px",
      "padding": "3px 8px",
      "radius": "2px",
      "font": "11px/400 mono, .08em",
      "bg": "var(--bg-2)",
      "border": "1px solid var(--line)",
      "states": {
        "active": "bg var(--accent), color var(--accent-ink)"
      }
    },
    "nav": {
      "height": "56px",
      "padding": "0 24px",
      "border": "alt 1px solid var(--line)",
      "font": "12.5px/400 mono, .08em",
      "states": {
        "active": "color var(--accent)",
        "pasif": "color var(--ink-soft)"
      }
    },
    "tableRow": {
      "height": "44px",
      "padding": "0 10px",
      "border": "alt 1px solid var(--line)",
      "font": "15.5px/400 body, tabular-nums",
      "states": {
        "hover": "bg var(--bg-2)",
        "secili": "bg var(--surface-2)"
      }
    },
    "modal": {
      "width": "520px",
      "padding": "24px",
      "radius": "4px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "states": {
        "backdrop": "rgba(27,30,35,.40)"
      }
    },
    "toast": {
      "height": "40px",
      "padding": "10px 14px",
      "radius": "2px",
      "bg": "var(--ink)",
      "color": "var(--bg)",
      "font": "12.5px/400 mono",
      "states": {
        "show": "opacity 0→1, 180ms"
      }
    },
    "chart": {
      "series": "2 (accent, ink-soft)",
      "stroke": "1px",
      "fill": "yok",
      "grid": "1px hairline, yalnız yatay",
      "states": {
        "legend": "mono 11px"
      }
    }
  },
  "motion": {
    "fast": "100ms",
    "base": "180ms",
    "slow": "300ms",
    "easing": "linear",
    "properties": [
      "opacity",
      "transform",
      "content"
    ],
    "reduced": "0.01ms — hareket yalnız opacity, diyagram statik",
    "forbidden": [
      "parallax",
      "pin/scrub",
      "spring/overshoot",
      "harf harf animasyon",
      "blur geçişi",
      "sayfa geçişinde slide"
    ],
    "family": "Yayın & Tipografi",
    "sequences": {
      "enter": {
        "duration": "0.33s",
        "ease": "linear",
        "offsetY": "0px",
        "stagger": "0.04"
      },
      "scroll": {
        "trigger": "top 89%",
        "duration": "0.42s",
        "offsetY": "10px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "120ms",
        "imageScale": "1.000"
      }
    },
    "choreography": {
      "enter": "line-mask",
      "scroll": "counter",
      "hover": "underline-draw",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "must": [
