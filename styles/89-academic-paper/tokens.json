  },
  "elevation": {
    "levels": [
      "bg",
      "surface",
      "overlay"
    ],
    "shadow": "0 1px 2px rgba(27,30,35,.08)",
    "shadowHard": "none",
    "rule": "Derinlik gölgeden gelmez: 1px hairline ve zemin tonu yeter. Gölge yalnız açılır menüde tek katman 1px; kart/modal gölgesiz."
  },
  "spacing": {
    "unit": "4px",
