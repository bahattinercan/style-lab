    "chip": {
      "h": "24px",
      "pad": "0 10px",
      "radius": "999px",
      "type": "11/500 mono",
      "color": "--surface-2 + --line",
      "states": "aktif: --accent + --accent-ink"
    },
    "nav": {
      "h": "64px",
      "pad": "0 24px",
      "radius": "—",
      "type": "14/500",
      "color": "--bg + alt 1px --line",
      "states": "active: --ink + 2px underline"
    },
    "tableRow": {
      "h": "52px",
      "pad": "12px 16px",
      "radius": "—",
      "type": "14/400 number mono",
      "color": "underline 1px --line",
      "states": "hover: --surface-2 · selected: left 2px --accent"
    },
    "modal": {
      "h": "content",
      "pad": "28px",
      "radius": null,
      "type": "H3+14 body",
      "color": "--surface + --shadow",
      "states": "arka plan --bg %72 + 8px blur"
    },
    "toast": {
      "h": "44px",
      "pad": "0 16px",
      "radius": null,
      "type": "13/500",
      "color": "--ink background + --bg text",
      "states": "icon + single line, 4sec"
    },
    "chart": {
      "h": "—",
      "pad": "—",
      "radius": null,
      "type": "11px mono axis",
      "color": "--accent + 16% accent fill + --line reference",
      "states": "three series at most"
    }
