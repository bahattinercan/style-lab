      "h": "44px",
      "pad": "0 14px",
      "radius": null,
      "type": "14/400",
      "color": "--surface + 1px --line",
      "states": "focus: 2px --accent ring error: --danger edge + 12px description disabled: --bg-2"
    },
    "card": {
      "h": "content",
      "pad": "20px",
      "radius": null,
      "type": "H3+14 body",
      "color": "--surface + --line + --shadow",
      "states": "hover only on clickable card: edge --ink 18%"
