  "version": 4,
  "css": "[data-style=\"trading-desk\"] { --bg: #101418; --bg-2: #151b20; --surface: #161d23; --surface-2: #1c242b; --ink: #e8eef2; --ink-soft: #9fb3bf; --ink-faint: #6f8593; --accent: #f2a33c; --accent-ink: #171002; --line: rgba(232,238,242,.14); --radius: 2px; --radius-lg: 4px; --shadow: none; --shadow-hard: none; --font-display: \"Rajdhani\", system-ui, sans-serif; --font-body: \"Space Grotesk\", system-ui, sans-serif; --font-mono: \"JetBrains Mono\", ui-monospace, monospace; --tracking: 0.015em; --blur: 0px; --grain: 0; --danger: #ff7a6b; --danger-ink: #260a05; --ok: #35d07f; --warn: #e8d05a; }",
