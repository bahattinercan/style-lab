      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "32px",
      "mobile": "24px"
    },
    "cardPadding": "8px"
  },
  "grid": {
    "columns": 12,
    "gutter": "8px",
    "container": "1440px",
    "measure": "58ch",
    "breakpoints": {
      "sm": "390px",
      "md": "768px",
      "lg": "1360px"
    },
    "asymmetry": "kalıcı asimetri: ana emir defteri 5 kolon, grafik 4 kolon, pozisyon tablosu 3 kolon — oran sabit"
  },
  "layout": {
    "hero": "split",
    "nav": "inline",
    "density": "dense",
    "family": "Veri & Gösterge"
  },
  "imagery": {
    "icons": "12–14px, 1.5px çizgi; ok (▲▼) dışında ikon yok",
    "photos": "yok",
    "illustration": "yok — her görsel alan grafik, derinlik çubuğu veya sayı ile doldurulur",
    "texture": "yok (--grain: 0); diyagonal şerit deseni yalnız ticker bandında",
    "logo": "12px kelime markası, Rajdhani büyük harf, .1em tracking; accent nokta ile",
    "photo": "urb-02.jpg",
    "treatment": {
      "mode": "scrim",
      "strength": 0.55
    }
  },
  "components": {
    "button": {
      "height": "28px",
      "padding": "0 10px",
      "radius": "var(--radius)",
      "font": "12px/600 Rajdhani, büyük harf, .08em",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "accent %92 + ink karışımı, 70ms",
        "active": "translateY(1px), zemin %85",
        "focus": "outline 2px solid var(--accent); outline-offset: 1px",
        "disabled": "opacity .4, kesikli 1px kenar",
        "loading": "satır içi 3 nokta, 600ms steps(3)"
      }
    },
    "buttonSecondary": {
      "height": "28px",
      "padding": "0 10px",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)",
      "color": "var(--ink)"
    },
    "input": {
      "height": "28px",
      "padding": "0 8px",
      "radius": "var(--radius)",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "focus": "outline 2px solid var(--accent); outline-offset: 1px; imleç accent",
      "error": "border-color var(--danger) + sağda 12px `!` + alan altı 11px mono metin"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "8px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "note": "panel başlığı 24px yüksekliğinde şerit: solda 11px büyük harf etiket, sağda canlı LED"
    },
    "chip": {
      "height": "18px",
      "padding": "0 5px",
      "radius": "var(--radius)",
      "font": "11px/500 JetBrains Mono",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)"
    },
    "nav": {
      "height": "44px",
      "padding": "0 12px",
      "borderBottom": "1px solid var(--line)",
      "note": "altında 28px ticker bandı: 12px mono sembol + fiyat + ▲▼ yüzde, 8 saniyede bir kayar"
    },
    "tableRow": {
      "height": "24px",
      "padding": "0 8px",
      "border": "yok; satır ayrımı --surface ve --surface-2 zebra",
      "note": "emir defteri: sol bid (ok), sağ ask (danger), ortada derinlik çubuğu"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "12px",
      "bg": "var(--surface)",
      "border": "1px solid var(--accent)",
      "shadow": "none",
      "note": "onay modalları: emir özeti 4 satır mono, miktar 20px mono, tek tehlike butonu"
    },
    "toast": {
      "height": "26px",
      "padding": "0 8px",
      "radius": "var(--radius)",
      "duration": "2500ms, sağ alt; 4 toast üst sınır",
      "note": "dolum/iptal bildirimi: sembol + eylem + miktar tek satır"
    },
    "chart": {
      "series": "var(--ok), var(--danger), var(--accent), var(--ink-soft)",
      "maxSeries": 4,
      "note": "mum 3px gövde + 1px fitil; hacim çubukları grafiğin %18'inde; yatay çizgi 1px kesikli --ink-soft"
    }
  },
  "motion": {
    "fast": "70ms",
    "base": "220ms",
    "slow": "320ms",
    "easing": "cubic-bezier(.4,0,.1,1) — keskin giriş, kısa kuyruk",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms; fiyat flash'ı kapanır, ticker kayması durur",
    "forbidden": [
      "Yay/ease-out yumuşaklığı",
      "Sürekli döngü (ticker dışında)",
      "Blur geçişi",
      "Sayaç yuvarlanması (fiyat son iki hanede bile atlamadan yazılır)"
    ],
    "family": "Veri & Gösterge",
    "sequences": {
      "enter": {
        "duration": "0.22s",
        "ease": "cubic-bezier(.4,0,.1,1)",
        "offsetY": "4px",
        "stagger": "0.015"
      },
      "scroll": {
        "trigger": "top 92%",
        "duration": "0.26s",
        "offsetY": "6px",
        "once": true
      },
      "pin": {
        "enabled": true,
        "scrub": "0.35",
        "distance": "+70%"
      },
      "hover": {
        "duration": "70ms",
        "imageScale": "1.004"
      }
    },
    "choreography": {
      "enter": "fade-rise",
      "scroll": "reveal",
      "hover": "scale",
      "page": "crossfade",
      "reduced": "static-frame"
    }
  },
  "must": [
    "Her sayı mono + tabular; fiyat 2, hacim 0 ondalık — ondalık basamak sembole göre sabit",
    "Alış/satış yönü ▲▼ işareti + renk + metin (`ALIŞ`/`SATIŞ`) üçlüsüyle yazılır",
    "Emir defteri satır yüksekliği 24px, derinlik çubuğu satırın %0–100'ü",
    "Ekranın üst yarısı daima fiyat + pozisyon; alt yarısı emir defteri + grafik",
    "Ticker bandı en fazla 12 sembol; 8 saniyede bir, tek satır kayar",
    "Klavye kısayolu (B/S/Esc) buton etiketinde görünür"
  ],
  "mustNot": [
    "Yuvarlak kart, yumuşak gölge, cam efekti",
    "Gradient zemin veya gradient metin",
    "Süsleme amaçlı illüstrasyon, büyük fotoğraf",
    "Renk dışında yön kodu olmayan alış/satış gösterimi",
    "Sürekli nabız atan gösterge (ticker dışında)",
    "Ondalık basamağı değişen fiyat gösterimi"
  ],
