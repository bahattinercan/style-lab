{
  "slug": "neo-brutalism",
  "num": "13",
  "name": "Neo-Brutalism",
  "version": 4,
  "css": "[data-style=\"neo-brutalism\"] { --bg: #fffdf5; --bg-2: #ffe9a8; --surface: #ffffff; --surface-2: #ffd93d; --ink: #000000; --ink-soft: #2b2b2b; --ink-faint: #6b6b6b; --accent: #ff5c8a; --accent-ink: #000000; --line: #000000; --radius: 0px; --radius-lg: 4px; --shadow: 4px 4px 0 #000000; --shadow-hard: 0 0 0 #000000; --font-display: \"Archivo Black\", \"Space Grotesk\", system-ui, sans-serif; --font-body: \"Space Grotesk\", \"Inter\", system-ui, sans-serif; --font-mono: \"JetBrains Mono\", ui-monospace, monospace; --tracking: -0.02em; --blur: 0px; --grain: 0; --focus: #f25783;\n}",
  "palette": {
    "bg": "#fffdf5",
    "bg2": "#ffe9a8",
    "surface": "#ffffff",
    "surface2": "#ffd93d",
    "ink": "#000000",
    "inkSoft": "#2b2b2b",
    "inkFaint": "#6b6b6b",
    "accent": "#ff5c8a",
    "accentInk": "#000000",
    "line": "#000000",
    "dark": {
      "bg": "#111111",
      "bg2": "#2a2a1a",
      "surface": "#1b1b1b",
      "surface2": "#3a3320",
      "ink": "#fffdf5",
      "inkSoft": "#d8d4c8",
      "inkFaint": "#9a958a",
      "accent": "#ff5c8a",
      "accentInk": "#000000",
      "line": "#fffdf5"
    }
  },
  "typography": {
    "display": "Archivo Black",
    "body": "Space Grotesk",
    "mono": "JetBrains Mono",
    "scale": {
      "label": "11px",
      "caption": "12px",
      "small": "14px",
      "body": "16px",
      "h3": "20px",
      "h2": "32px",
      "h1": "64px",
      "h1Mobile": "36px"
    },
    "weights": {
      "body": 400,
      "strong": 700,
      "display": 400
    },
    "lineHeight": {
      "display": 0.98,
      "heading": 1,
      "body": 1.55
    },
    "tracking": {
      "display": "-0.02em",
      "heading": "-0.02em",
      "body": "0",
      "label": "0.12em"
    },
    "transform": {
      "display": "uppercase",
      "button": "uppercase",
      "label": "uppercase",
      "body": "none"
    },
    "measure": "60ch",
    "forbidden": [
      "gövdede uppercase",
      "sahte bold (font-synthesis)",
      "display'de 400 dışı ağırlık"
    ]
  },
  "shape": {
    "radius": "0px",
    "radiusLg": "4px",
    "border": "2px solid var(--line)",
    "borderLarge": "3px solid var(--line)",
    "maxRadius": "4px"
  },
  "elevation": {
    "levels": [
      "bg",
      "card (4px ofset)",
      "featured (8px ofset)",
      "floating (12px ofset)"
    ],
    "shadow": "4px 4px 0 #000000",
    "shadowFeatured": "8px 8px 0 #000000",
    "shadowFloating": "12px 12px 0 #000000",
    "rule": "Derinlik kaymadan gelir; blur yok, gölge rengi her zaman --ink",
    "interaction": "hover'da gölge küçülür, öğe gölge yönüne kayar (translate(4px,4px))"
  },
  "motion": {
    "fast": "90ms",
    "base": "120ms",
    "slow": "240ms",
    "easing": "ease-out / cubic-bezier(.34,1.4,.64,1) tek seferlik pop",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms; basılma efekti opacity ile",
    "forbidden": [
      "uzun spring",
      "parallax",
      "sürekli döngü",
      "blur animasyonu"
    ],
    "family": "Cesur",
    "sequences": {
      "enter": {
        "duration": "0.28s",
        "ease": "linear",
        "offsetY": "8px",
        "stagger": "0.02"
      },
      "scroll": {
        "trigger": "top 88%",
        "duration": "0.32s",
        "offsetY": "16px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "90ms",
        "imageScale": "1.03"
      }
    },
    "choreography": {
      "enter": "split-slide",
      "scroll": "stack-pin",
      "hover": "underline-draw",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "spacing": {
    "unit": "8px",
    "scale": [
      "4px",
      "8px",
      "12px",
      "16px",
      "24px",
      "32px",
      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "56px",
      "mobile": "40px"
    },
    "cardPadding": "20px",
    "shadowGutter": "8–12px"
  },
  "grid": {
    "columns": 12,
    "gutter": "16px",
    "container": "1200px",
    "breakpoints": {
      "sm": "640px",
      "md": "900px",
      "lg": "1200px"
    },
    "asymmetry": "hero 7/5 + 1 tam genişlik sticker şerit"
  },
  "layout": {
    "hero": "split-reverse",
    "nav": "inline",
    "density": "dense",
    "family": "Cesur"
  },
  "components": {
    "button": {
      "height": "48px",
      "padding": "0 22px",
      "radius": "var(--radius)",
      "font": "14px/700 uppercase",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "border": "2px solid var(--ink)",
      "shadow": "4px 4px 0 var(--ink)",
      "states": {
        "hover": "translate(4px,4px) + shadow none",
        "active": "translate(4px,4px)",
        "focus": "outline 3px var(--ink), offset 3px",
        "disabled": "opacity .40, shadow none"
      }
    },
    "buttonSecondary": {
      "height": "48px",
      "padding": "0 20px",
      "bg": "var(--surface)",
      "border": "2px solid var(--ink)",
      "shadow": "4px 4px 0 var(--ink)"
    },
    "buttonSticker": {
      "height": "48px",
      "bg": "var(--surface-2)",
      "border": "2px solid var(--ink)"
    },
    "input": {
      "height": "48px",
      "padding": "0 14px",
      "radius": "var(--radius)",
      "font": "15px/400",
      "bg": "var(--surface)",
      "border": "2px solid var(--ink)",
      "focus": "outline 3px var(--accent), offset 2px",
      "error": "border-color var(--danger) + 12/700 açıklama"
    },
    "card": {
      "padding": "20px",
      "radius": "var(--radius-lg)",
      "border": "2px solid var(--ink)",
      "shadow": "4px 4px 0 var(--ink)",
      "hover": "translate(-2px,-2px) + 6px 6px 0"
    },
    "chip": {
      "height": "26px",
      "padding": "0 10px",
      "radius": "0",
      "font": "11px/500 mono uppercase",
      "bg": "var(--surface-2)",
      "border": "2px solid var(--ink)"
    },
    "nav": {
      "height": "64px",
      "padding": "0 24px",
      "borderBottom": "2px solid var(--ink)",
      "active": "3px alt çizgi var(--accent)"
    },
    "tableRow": {
      "height": "56px",
      "padding": "12px 16px",
      "border": "2px solid var(--ink) alt",
      "numbers": "mono 13/700"
    },
    "modal": {
      "padding": "24px",
      "radius": "var(--radius-lg)",
      "border": "3px solid var(--ink)",
      "shadow": "12px 12px 0 var(--ink)",
      "backdrop": "rgba(0,0,0,.4)"
    },
    "toast": {
      "height": "48px",
      "bg": "var(--ink)",
      "color": "var(--bg)",
      "border": "2px solid var(--bg)",
      "duration": "4s"
    },
    "chart": {
      "series": "var(--accent) + var(--surface-2)",
      "frame": "2px solid var(--ink)",
      "axis": "11px mono"
    }
  },
  "imagery": {
    "icons": "2px çizgi, köşe yok, 24px kutu; dolgulu serbest",
    "photos": "yüksek kontrast, sert gölge, duotone (accent + ink)",
    "illustration": "kalın konturlu, düz dolgulu vektör",
    "texture": "yok (grain 0); kağıt hissi için en fazla .03",
    "decor": "ok/yıldız/balon, en fazla 2 öğe, 2px kontur",
    "photo": "obj-03.jpg",
    "treatment": {
      "mode": "duotone",
      "strength": 0.35
    }
  },
  "must": [
    "Tüm bileşenlerde aynı kenarlık kalınlığı (2px, büyük yüzeyde 3px)",
    "Blur'suz ofset gölge, aynı yönde (4/8/12px)",
    "Radius 0–4px",
    "Display uppercase Archivo Black, gövde normal case",
    "Doygun renk en fazla 3 (pembe, sarı, krem) + siyah",
    "Hover'da gölge küçülür, öğe gölge yönüne kayar"
  ],
  "mustNot": [
    "Gradient, blur, cam, yumuşak gölge",
    "4px üstü radius",
    "Gövde metninde uppercase",
    "Sahte bold / birden fazla display ağırlığı",
    "Gri tonlarının çoğaltılması (1 siyah + 1 koyu + 1 orta yeter)",
    "Ödeme/giriş ekranında tam yoğunluk"
  ],
  "neighbors": {
    "compatible": [
      "memphis",
      "anti-design",
      "conceptual-sketch"
    ],
    "forbidden": [
      "glassmorphism",
      "luxury-typography",
      "japandi"
    ]
  },
  "refs": [
    {
      "label": "Gumroad",
      "url": "https://gumroad.com",
      "use": "ürün arayüzünde neo-brutalist davranış"
    },
    {
      "label": "Neobrutalism.dev",
      "url": "https://www.neobrutalism.dev",
      "use": "buton/kart/input bileşen seti"
    },
    {
      "label": "Brutalist Websites",
      "url": "https://brutalistwebsites.com",
      "use": "doz ayarı, ham örnekler"
    }
  ],
  "industries": [
    "ajans",
    "eticaret"
  ]
}
