        "disabled": "opacity .45, gölge yok",
        "loading": "3 çıkartma sırası dolar"
      }
    },
    "buttonSecondary": {
      "height": "52px",
      "padding": "14px 24px",
      "radius": "10px",
      "font": "15px/700 body",
      "bg": "var(--surface)",
      "color": "var(--ink)",
      "border": "6px solid var(--surface)",
      "states": {
        "hover": "translateY(-4px)"
      }
    },
    "input": {
      "height": "48px",
      "padding": "12px 14px",
      "radius": "10px",
      "font": "16.5px/400 body",
      "bg": "var(--surface)",
      "border": "2px solid var(--line)",
      "states": {
        "focus": "outline 2px var(--accent), offset 3px",
        "filled": "bg var(--surface-2)",
        "error": "kenar 2px var(--accent) + 13px mesaj",
        "disabled": "opacity .5"
      }
    },
    "card": {
      "padding": "20px",
      "radius": "10px",
      "bg": "var(--surface)",
      "border": "6px solid var(--surface)",
      "shadow": "2px 2px 0 var(--shadow-hard)",
      "states": {
        "hover": "translateY(-8px) rotate(0deg)"
      }
    },
    "chip": {
      "height": "28px",
      "padding": "4px 10px",
      "radius": "10px",
      "font": "13px/400 body",
      "bg": "var(--surface-2)",
      "border": "none",
      "states": {
        "active": "bg var(--accent), color var(--accent-ink)"
      }
    },
    "nav": {
      "height": "64px",
      "padding": "0 24px",
      "border": "alt 2px solid var(--line)",
      "font": "15px/700 body",
      "states": {
        "active": "color var(--accent)",
        "pasif": "color var(--ink-soft)"
      }
    },
    "tableRow": {
      "height": "56px",
      "padding": "0 14px",
      "border": "alt 1px solid var(--line)",
      "font": "15px/400 body + 12px mono",
      "states": {
        "hover": "bg var(--surface-2)",
        "secili": "bg var(--surface-2)"
      }
    },
    "modal": {
      "width": "520px",
      "padding": "24px",
      "radius": "16px",
      "bg": "var(--surface)",
      "border": "6px solid var(--surface)",
      "shadow": "0 14px 28px rgba(22,22,15,.12)",
      "states": {
        "backdrop": "rgba(22,22,15,.45)"
      }
    },
    "toast": {
      "height": "48px",
      "padding": "12px 16px",
      "radius": "10px",
      "bg": "var(--ink)",
      "color": "var(--bg)",
      "font": "13px/700 body",
      "states": {
        "show": "translateY(-12px) + opacity, 200ms"
      }
    },
    "chart": {
      "series": "3 (accent, ink, surface-2)",
      "stroke": "10px yuvarlak çubuk",
      "fill": "düz",
      "grid": "yok",
      "states": {
        "legend": "12px Silkscreen"
      }
    }
