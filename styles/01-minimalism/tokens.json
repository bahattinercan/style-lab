{
  "slug": "minimalism",
  "num": "01",
  "name": "Minimalism",
  "version": 4,
  "css": "[data-style=\"minimalism\"] { --bg: #fafaf9; --bg-2: #f2f2f0; --surface: #ffffff; --surface-2: #f7f7f5; --ink: #101112; --ink-soft: #5a5f66; --ink-faint: #9aa0a6; --accent: #2563eb; --accent-ink: #ffffff; --line: rgba(16,17,18,.10); --radius: 8px; --radius-lg: 12px; --shadow: 0 1px 2px rgba(16,17,18,.06); --shadow-hard: none; --font-display: \"Inter\", system-ui, sans-serif; --font-body: \"Inter\", system-ui, sans-serif; --font-mono: \"JetBrains Mono\", ui-monospace, monospace; --tracking: -0.02em; --blur: 0px; --grain: 0; }",
  "palette": {
    "bg": "#fafaf9",
    "bg2": "#f2f2f0",
    "surface": "#ffffff",
    "surface2": "#f7f7f5",
    "ink": "#101112",
    "inkSoft": "#5a5f66",
    "inkFaint": "#9aa0a6",
    "accent": "#2563eb",
    "accentInk": "#ffffff",
    "line": "rgba(16,17,18,.10)",
    "dark": {
      "bg": "#0b0b0c",
      "bg2": "#121214",
      "surface": "#161618",
      "surface2": "#1d1d20",
      "ink": "#ededed",
      "inkSoft": "#a0a4aa",
      "inkFaint": "#6f747a",
      "accent": "#60a5fa",
      "accentInk": "#0b0b0c",
      "line": "rgba(255,255,255,.12)"
    }
  },
  "typography": {
    "display": "Inter",
    "body": "Inter",
    "mono": "JetBrains Mono",
    "scale": {
      "label": "11px",
      "caption": "12px",
      "small": "14px",
      "body": "16px",
      "h3": "20px",
      "h2": "28px",
      "h1": "56px",
      "h1Mobile": "34px"
    },
    "weights": {
      "body": 400,
      "strong": 600,
      "display": 700
    },
    "lineHeight": {
      "display": 1.02,
      "heading": 1.15,
      "body": 1.6
    },
    "tracking": {
      "display": "-0.03em",
      "heading": "-0.02em",
      "body": "0",
      "label": "0.14em"
    },
    "measure": "68ch",
    "forbidden": [
      "500 ağırlık",
      "18/22/26px ara basamaklar"
    ]
  },
  "shape": {
    "radius": "8px",
    "radiusLg": "12px",
    "border": "1px solid var(--line)",
    "maxRadius": "12px"
  },
  "elevation": {
    "levels": [
      "bg",
      "surface",
      "overlay"
    ],
    "shadow": "0 1px 2px rgba(16,17,18,.06)",
    "shadowHard": "none",
    "rule": "Gölge yalnızca yüzen katmanda; kart ayrımı 1px --line ile"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "240ms",
    "easing": "ease-out / cubic-bezier(.2,.6,.2,1)",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms (tokens.css global)",
    "forbidden": [
      "spring",
      "bounce",
      "parallax",
      "sürekli döngü"
    ],
    "family": "Sade",
    "sequences": {
      "enter": {
        "duration": "0.5s",
        "ease": "ease-out",
        "offsetY": "12px",
        "stagger": "0.04"
      },
      "scroll": {
        "trigger": "top 86%",
        "duration": "0.6s",
        "offsetY": "24px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "160ms",
        "imageScale": "1.015"
      }
    },
    "choreography": {
      "enter": "fade-rise",
      "scroll": "reveal",
      "hover": "scale",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "spacing": {
    "unit": "8px",
    "scale": [
      "4px",
      "8px",
      "12px",
      "16px",
      "24px",
      "32px",
      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "80px",
      "mobile": "48px"
    },
    "cardPadding": "24px"
  },
  "grid": {
    "columns": 12,
    "gutter": "24px",
    "container": "1160px",
    "measure": "720px",
    "breakpoints": {
      "sm": "640px",
      "md": "900px",
      "lg": "1200px"
    },
    "asymmetry": "ekran başına 1 bölüm (ör. hero 7/5)"
  },
  "layout": {
    "hero": "centered",
    "nav": "split",
    "density": "sparse",
    "family": "Sade"
  },
  "components": {
    "button": {
      "height": "44px",
      "padding": "0 20px",
      "radius": "var(--radius)",
      "font": "14px/600",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "brightness(.92)",
        "active": "translateY(1px)",
        "focus": "outline 2px var(--accent), offset 2px",
        "disabled": "opacity .40"
      }
    },
    "buttonSecondary": {
      "height": "44px",
      "padding": "0 18px",
      "bg": "transparent",
      "border": "1px solid var(--line)",
      "color": "var(--ink)"
    },
    "input": {
      "height": "44px",
      "padding": "0 14px",
      "radius": "var(--radius)",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "focus": "outline 2px var(--accent), offset 1px",
      "error": "border-color var(--danger) + 12px açıklama"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "24px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "var(--shadow)"
    },
    "chip": {
      "height": "24px",
      "padding": "0 10px",
      "radius": "999px",
      "font": "11px/500",
      "bg": "var(--surface-2)"
    },
    "nav": {
      "height": "64px",
      "padding": "0 24px",
      "borderBottom": "1px solid var(--line)"
    },
    "tableRow": {
      "height": "52px",
      "padding": "12px 16px",
      "numbers": "mono 13px",
      "border": "1px solid var(--line) alt kenar"
    },
    "modal": {
      "width": "480-560px",
      "padding": "28px",
      "radius": "var(--radius-lg)",
      "backdrop": "rgba(16,17,18,.32)"
    },
    "toast": {
      "height": "44px",
      "radius": "var(--radius)",
      "bg": "var(--ink)",
      "color": "var(--bg)",
      "duration": "4s"
    },
    "chart": {
      "series": "var(--accent) + var(--accent)/.16 dolgu + var(--ink-faint) referans",
      "axis": "11px mono",
      "maxSeries": 3
    }
  },
  "imagery": {
    "icons": "1.5px çizgi, 24px kutu, round cap",
    "photos": "yumuşak ışık, düşük doygunluk, tek konu, 12px radius kırpma",
    "illustration": "yok; gerekiyorsa line-art --ink-soft",
    "texture": "yok (--grain: 0)",
    "logo": "monokrom --ink, min 24px yükseklik",
    "photo": "int-03.jpg",
    "treatment": {
      "mode": "plain",
      "strength": 0
    }
  },
  "must": [
    "Tek vurgu rengi; gerisi 5–7 tonluk nötr skala",
    "Hiyerarşi boşluk + 1.5× punto zıplaması + 400/600 ağırlık ile",
    "Kart ayrımı 1px --line; gölge yalnızca yüzen katmanda",
    "Boşluk 8'in katları; bölüm dikey 80/48px",
    "Gövde satır uzunluğu en fazla 68ch",
    "44×44px dokunma hedefi ve görünür odak halkası"
  ],
  "mustNot": [
    "Gradient, blur, grain, iç gölge, parlaklık",
    "İkinci aksan rengi veya süsleme amaçlı renk",
    "16px üzeri radius, çok katmanlı gölge",
    "Ara punto basamakları (18/22/26) ve 500 ağırlık",
    "Izgarayı görünür kılan yardımcı çizgiler"
  ],
  "neighbors": {
    "compatible": [
      "swiss-design",
