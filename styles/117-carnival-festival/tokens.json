{
  "slug": "carnival-festival",
  "num": "117",
  "name": "Carnival Festival",
  "version": 4,
  "css": "[data-style=\"carnival-festival\"] { --bg: #fdf3e3; --bg-2: #f6e7d0; --surface: #fffaf0; --surface-2: #f7ead6; --ink: #241a12; --ink-soft: #55463a; --ink-faint: #827164; --accent: #b3360f; --accent-ink: #fdf5ee; --line: rgba(36,26,18,.18); --radius: 0px; --radius-lg: 4px; --shadow: none; --shadow-hard: 3px 3px 0 rgba(36,26,18,.92); --font-display: \"Anton\", Impact, system-ui, sans-serif; --font-body: \"Poppins\", system-ui, sans-serif; --font-mono: \"JetBrains Mono\", ui-monospace, monospace; --tracking: -0.01em; --blur: 0px; --grain: 0; }",
