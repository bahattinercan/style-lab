      "32px",
      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "72px",
      "mobile": "44px"
    },
    "cardPadding": "20px"
  },
  "grid": {
    "columns": 12,
    "gutter": "24px",
    "container": "1200px",
    "measure": "52ch",
    "breakpoints": {
      "sm": "390px",
      "md": "768px",
      "lg": "1200px"
    },
    "asymmetry": "Program sütunu 7/12, sahne kartı 5/12; ekran başına 2 asimetrik blok."
  },
  "layout": {
    "hero": "split-reverse",
    "nav": "utility",
    "density": "dense",
    "family": "Oyuncul"
  },
  "imagery": {
    "icons": "2px çizgi, kare uç, 20px ızgara; ikon daima uppercase etiketle",
    "photos": "Sahne/kalabalık fotoğrafı, yüksek kontrast, alan ≤%35; renkli overlay yok",
    "illustration": "Konfeti ve şerit vektörü: düz renk, 0 gölge; ekran başına 1 kompozisyon",
    "texture": "Yok (`--grain: 0`); düz zemin + şerit",
    "logo": "Sol üst 20px, Anton 24px uppercase; sembol yok",
    "photo": "tex-02.jpg",
    "treatment": {
      "mode": "duotone",
      "strength": 0.3
    }
  },
  "components": {
    "button": {
      "height": "52px",
      "padding": "14px 26px",
      "radius": "0px",
      "font": "13px/700 body, .06em uppercase",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "translateY(2px) + alt şerit 2px",
        "active": "translateY(3px)",
        "focus": "outline 3px var(--accent), offset 2px",
        "disabled": "opacity .45",
        "loading": "bant 3 adımda dolar"
      }
    },
    "buttonSecondary": {
      "height": "52px",
      "padding": "14px 26px",
      "radius": "0px",
      "font": "13px/700 body, .06em",
      "bg": "var(--bg)",
      "color": "var(--ink)",
      "border": "2px solid var(--ink)",
      "states": {
        "hover": "bg var(--surface-2)"
      }
    },
    "input": {
      "height": "48px",
      "padding": "12px 14px",
      "radius": "4px",
      "font": "16.5px/400 body",
      "bg": "var(--surface)",
      "border": "2px solid var(--line)",
      "states": {
        "focus": "outline 3px var(--accent), offset 1px",
        "filled": "bg var(--surface-2)",
        "error": "kenar 2px var(--accent)",
        "disabled": "opacity .5"
      }
    },
    "card": {
      "padding": "20px",
      "radius": "4px",
      "bg": "var(--surface)",
      "border": "1px solid var(--ink)",
      "shadow": "none",
      "states": {
        "hover": "shadow 3px 3px 0 var(--shadow-hard)"
      }
    },
    "chip": {
      "height": "26px",
      "padding": "4px 10px",
      "radius": "0px",
      "font": "12px/400 mono, .1em uppercase",
      "bg": "var(--ink)",
      "color": "var(--bg)",
      "states": {
        "yakin": "bg var(--accent), color var(--accent-ink)"
      }
    },
    "nav": {
      "height": "60px",
      "padding": "0 24px",
      "border": "alt 2px solid var(--ink)",
      "font": "13px/700 body, .06em uppercase",
      "states": {
        "active": "alt kenar 3px var(--accent)",
        "pasif": "color var(--ink-soft)"
      }
    },
    "tableRow": {
      "height": "56px",
      "padding": "0 12px",
      "border": "alt 1px solid var(--line)",
      "font": "16.5px/400 body + 12px mono tarih",
      "states": {
        "hover": "bg var(--surface-2)",
        "secili": "bg var(--surface-2)"
      }
    },
    "modal": {
      "width": "560px",
      "padding": "24px",
      "radius": "4px",
      "bg": "var(--surface)",
      "border": "2px solid var(--ink)",
      "shadow": "none",
      "states": {
        "backdrop": "rgba(36,26,18,.50)"
      }
    },
    "toast": {
      "height": "48px",
      "padding": "12px 16px",
      "radius": "0px",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "font": "12px/400 mono, .1em uppercase",
      "states": {
        "show": "translateY(-30px) → 0, 280ms"
      }
    },
    "chart": {
      "series": "3 (accent, ink, surface-2)",
      "stroke": "8px şerit (bar)",
      "fill": "düz",
      "grid": "yok",
      "states": {
        "legend": "12px mono .1em"
      }
    }
  },
  "motion": {
    "fast": "90ms",
    "base": "180ms",
    "slow": "280ms",
    "easing": "cubic-bezier(.34,1.56,.64,1)",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms (tokens.css global) — şerit animasyonsuz yerleşir",
    "forbidden": [
      "sürekli kayan şerit",
      "strobe/flaş",
      "sürekli döngü",
      "parallax",
      "pin/scrub",
      "blur geçişi"
    ],
    "family": "Oyuncul",
    "sequences": {
      "enter": {
        "duration": "0.28s",
        "ease": "cubic-bezier(.34,1.56,.64,1)",
        "offsetY": "30px",
        "stagger": "0.05"
      },
      "scroll": {
        "trigger": "top 91%",
        "duration": "0.36s",
        "offsetY": "24px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "120ms",
        "imageScale": "1.06"
      }
    },
    "choreography": {
      "enter": "scale-settle",
      "scroll": "grid-stagger",
      "hover": "scale",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "must": [
    "Anton 72px/0.94/−0.01em bant başlık, tek satır (mobil 40px); gövde Poppins 16.5px/1.6/52ch",
