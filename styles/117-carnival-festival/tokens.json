    ]
  },
  "shape": {
    "radius": "0px",
    "radiusLg": "4px",
    "border": "1px solid var(--line)",
    "rule": "Radius 0px (bant/şerit/buton) ve 4px (bilet/kart/modal); 6px üstü yasak; aksiyon rozeti 999px istisnası yok."
  },
  "elevation": {
    "levels": [
      "bg",
      "surface",
      "overlay"
    ],
    "shadow": "none",
    "shadowHard": "3px 3px 0 rgba(36,26,18,.92)",
    "rule": "Gölge yok; derinlik 1px çerçeve, 8px şerit ve bilet perforasyonundan gelir. Sert ofset yalnız bilet hover'ında."
  },
  "spacing": {
    "unit": "4px",
    "scale": [
      "4px",
      "8px",
      "12px",
