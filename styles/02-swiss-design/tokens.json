      "height": "48px",
      "padding": "0 14px",
      "radius": "0",
      "border": "2px solid var(--ink)",
      "focus": "outline 3px var(--accent)",
      "error": "border-color var(--danger)"
    },
    "card": {
      "padding": "24px",
      "radius": "0",
      "border": "2px solid var(--ink)",
      "shadow": "none"
    },
    "chip": {
      "height": "24px",
      "padding": "0 8px",
      "radius": "0",
      "font": "10px/500 mono uppercase",
