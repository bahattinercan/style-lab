      "borderBottom": "3px solid var(--ink)"
    },
    "tableRow": {
      "height": "48px",
      "padding": "10px 16px",
      "border": "1px solid var(--ink) alt",
      "head": "var(--bg-2) + 2px alt"
    },
    "modal": {
      "padding": "32px",
      "radius": "0",
      "border": "3px solid var(--ink)",
      "backdrop": "rgba(10,10,10,.5)"
    },
    "toast": {
      "height": "44px",
      "bg": "var(--ink)",
      "color": "var(--bg)",
      "accentBar": "4px sol kenar var(--accent)"
    },
    "chart": {
      "series": "tek seri var(--accent)",
      "axis": "11px mono",
      "reference": "1px var(--ink)"
