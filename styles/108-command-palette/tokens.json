      "accent": "#cfe0ff",
      "accentInk": "#06101f",
      "line": "rgba(248,250,253,.12)"
    }
  },
  "typography": {
    "display": "JetBrains Mono",
    "body": "Inter",
    "mono": "JetBrains Mono",
    "scale": {
      "label": "11px",
