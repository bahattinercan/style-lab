{
  "slug": "command-palette",
  "num": "108",
  "name": "Komut Paleti",
  "version": 4,
  "css": "[data-style=\"command-palette\"] { --bg: #111318; --bg-2: #16191f; --surface: #1b1f26; --surface-2: #222731; --ink: #eef0f3; --ink-soft: #a9b1bc; --ink-faint: #767e8a; --accent: #e8ecf2; --accent-ink: #14171c; --line: rgba(238,240,243,.14); --radius: 6px; --radius-lg: 12px; --shadow: 0 24px 60px rgba(0,0,0,.55); --shadow-hard: none; --font-display: \"JetBrains Mono\", ui-monospace, monospace; --font-body: \"Inter\", system-ui, sans-serif; --font-mono: \"JetBrains Mono\", ui-monospace, monospace; --tracking: 0em; --blur: 12px; --grain: 0; --danger: #ff8494; --danger-ink: #14171c; --ok: #86e0ae; --warn: #ffd27a; }",
