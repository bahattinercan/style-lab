  },
  "elevation": {
    "levels": [
      "bg",
      "surface",
      "overlay"
    ],
    "shadow": "0 24px 60px rgba(0,0,0,.55)",
    "shadowHard": "none",
    "rule": "Derinlik tek bir \"yüzen palet\" gölgesinden gelir (0 24px 60px). Palet içindeki satırlar gölge taşımaz; seçim yalnız accent dolgu ile işaretlenir."
  },
  "spacing": {
    "unit": "4px",
    "scale": [
      "4px",
      "8px",
      "12px",
      "16px",
      "24px",
      "32px",
      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "56px",
      "mobile": "32px"
    },
    "cardPadding": "16px"
  },
  "grid": {
    "columns": 12,
    "gutter": "16px",
    "container": "1040px",
    "measure": "72ch",
    "breakpoints": {
      "sm": "390px",
      "md": "768px",
      "lg": "1040px"
    },
    "asymmetry": "palet ortada tek kolon (en fazla 640px genişlik); arka plan karartılmış — asimetri yok, odak tek"
  },
  "layout": {
    "hero": "product",
    "nav": "utility",
    "density": "dense",
    "family": "Etkileşim"
  },
  "imagery": {
    "icons": "1.5px çizgi, 20px ızgara; komut ikonları, klavye tuş sembolleri",
    "photos": "yok — palet ekranı görsel taşımaz",
    "illustration": "yok; tuş başlıkları (keycap) ve satır hizası imza",
    "texture": "grain yok; arka plan blur var(--blur)=12px ile karartılır",
    "logo": "mono küçük harf wordmark + `>` işareti, 16px çevre boşluk",
    "photo": "int-02.jpg",
    "treatment": {
      "mode": "scrim",
      "strength": 0.4
    }
  },
  "components": {
    "button": {
      "height": "32px",
      "padding": "0 12px",
      "radius": "var(--radius)",
      "font": "12px/600 mono",
      "bg": "var(--surface-2)",
      "color": "var(--ink)",
      "shadow": "none",
      "states": {
        "hover": "surface-2 %85 + accent %15",
        "active": "translateY(1px)",
        "focus": "outline 2px solid var(--accent), offset 2px",
        "disabled": "opacity .4",
        "loading": "sağ uçta 3 nokta (600ms, tek tur)"
      }
    },
    "buttonSecondary": {
      "height": "32px",
      "padding": "0 12px",
      "bg": "transparent",
      "border": "1px solid var(--line)",
      "color": "var(--ink-soft)"
    },
    "input": {
      "height": "52px",
      "padding": "0 16px",
      "radius": "var(--radius)",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)",
      "focus": "outline 2px solid var(--accent), offset 1px",
      "error": "border-color var(--danger) + 11px mono etiket"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "16px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none",
      "note": "palet gövdesi: arama satırı 52px + komut satırları 44px"
    },
    "chip": {
      "height": "20px",
      "padding": "0 6px",
      "radius": "4px",
      "font": "11px/600 mono",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)",
      "note": "keycap chip: 20px, 4px radius, ⌘ sembolü"
    },
    "nav": {
      "height": "48px",
      "padding": "0 16px",
      "borderBottom": "1px solid var(--line)",
      "note": "nav yok sayılır; palet açıkken arka plan blur + %60 karartma"
    },
    "tableRow": {
      "height": "44px",
      "padding": "8px 12px",
      "border": "yok; seçim satırı accent dolgu"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "0",
      "border": "1px solid var(--line)",
      "shadow": "0 24px 60px rgba(0,0,0,.65)",
      "note": "palet modal: 640px, arama + liste + alt kısayol şeridi"
    },
    "toast": {
      "height": "32px",
      "padding": "6px 12px",
      "radius": "var(--radius)",
      "duration": "2500ms, alt-sağ",
      "note": "kısa onay; mono metin"
    },
    "chart": {
      "series": "var(--accent), var(--ink-soft), var(--warn), var(--danger)",
      "maxSeries": 3,
      "note": "grafik yok; sayısal çıktı mono satır olarak"
    }
  },
  "motion": {
    "fast": "65ms",
    "base": "120ms",
    "slow": "260ms",
    "easing": "cubic-bezier(.05,.9,.1,1)",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms (tokens.css global) — palet anında açılır",
    "forbidden": [
      "Yay/overshoot (palet anlıktır)",
      "Blur geçişi",
      "Saniyede 3 üstü flash",
      "Sürekli döngü"
    ],
    "family": "Etkileşim",
    "sequences": {
      "enter": {
        "duration": "0.19s",
        "ease": "cubic-bezier(.05,.9,.1,1)",
        "offsetY": "5px",
        "stagger": "0.018"
      },
      "scroll": {
        "trigger": "top 97%",
        "duration": "0.17s",
        "offsetY": "4px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "65ms",
        "imageScale": "1.000"
      }
    },
    "choreography": {
      "enter": "scale-settle",
      "scroll": "scroll-zoom",
      "hover": "scale",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "must": [
    "Klavye öncelikli: her eylem bir kısayolla erişilebilir ve kısayol satırda görünür",
    "Palet satırı 44px, arama alanı 52px; satır sayısı görünür alanda en fazla 8",
    "Seçim yalnız accent dolgu + sol 2px çizgi ile işaretlenir; gölge kullanılmaz",
    "Accent açık (chalk) tondur; metin accent üstünde koyu accent-ink olur",
    "Açık palet arka planı blur + karartma ile ayrılır; palet dışı içerik etkileşimsiz",
    "Tüm kısayollar mono ve 11px; keycap chip 20px/4px radius"
  ],
  "mustNot": [
    "Fare-öncelikli tek yol (kısayolsuz eylem)",
    "Büyük hero görseli ve dekoratif illüstrasyon",
    "Geniş hap radius, kalın çerçeve",
    "Çoklu parlak renk (tek chalk accent)",
    "Gölgeli satır (yalnız palet gölge taşır)",
    "Serif display"
  ],
