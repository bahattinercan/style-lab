      "64px"
    ],
    "sectionY": {
      "desktop": "68px",
      "mobile": "34px"
    },
    "cardPadding": "16px"
  },
  "grid": {
    "columns": 12,
    "gutter": "12px",
    "container": "1320px",
    "measure": "72ch",
    "breakpoints": {
      "sm": "390px",
      "md": "768px",
      "lg": "1280px"
    },
