  },
  "layout": {
    "hero": "product",
    "nav": "rail",
    "density": "dense",
    "family": "Deneysel & Gelecek"
  },
  "imagery": {
    "icons": "1.5px çizgi, 16px ızgara; sahne, ışık, kamera, katman işaretleri",
    "photos": "Yok — viewport içeriği şema (tel kafes/ızgara), fotoğraf değil",
