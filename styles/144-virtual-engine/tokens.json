    "texture": "--grain .02 + 32px dünya ızgarası (perspektif yok)",
    "logo": "Kelime logosu VT323 400, 0.08em; işaret 14px küp çizimi",
    "photo": "tex-02.jpg",
    "treatment": {
      "mode": "grain",
      "strength": 0.45
    }
  },
  "components": {
    "button": {
      "height": "34px",
      "padding": "0 14px",
      "radius": "var(--radius)",
      "font": "11px/400 mono, 0.06em",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "shadow": "none",
      "states": {
        "hover": "accent %86 + ink, 70ms (kare hissi)",
        "active": "translateY(1px)",
        "focus": "outline 2px solid var(--accent), offset 2px",
        "disabled": "opacity .42 + 1px dashed var(--line)",
        "loading": "4 kare blok animasyonu"
      }
    },
    "buttonSecondary": {
      "height": "34px",
      "padding": "0 14px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "color": "var(--ink)"
    },
    "input": {
      "height": "34px",
      "padding": "0 10px",
      "radius": "var(--radius)",
      "bg": "var(--bg-2)",
      "border": "1px solid var(--line)",
      "focus": "outline 2px solid var(--accent), offset 1px",
      "error": "border-color var(--danger) + mono açıklama"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "16px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "none"
    },
    "chip": {
      "height": "22px",
      "padding": "0 8px",
      "radius": "var(--radius)",
      "font": "10px/400 VT323, 0.06em",
      "bg": "var(--surface-2)",
      "border": "1px solid var(--line)"
    },
    "nav": {
      "height": "46px",
      "padding": "0 16px",
      "borderBottom": "1px solid var(--line)",
      "note": "sahne adı mono; sağda FPS/sayaç (tabular)"
    },
    "tableRow": {
      "height": "30px",
      "padding": "4px 8px",
      "border": "alt 1px var(--line)",
      "note": "varlık listesi: tür, kimlik, görünürlük; seçili sol 3px accent"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "18px",
      "border": "1px solid var(--line)",
      "shadow": "var(--shadow)",
      "note": "varlık denetçisi; sahne üstünde değil yanda açılır"
    },
    "toast": {
      "height": "32px",
      "padding": "6px 10px",
      "radius": "var(--radius)",
      "duration": "3000ms, sol alt (konsol satırı)",
      "note": "konsol gibi: zaman + mesaj mono"
    },
    "chart": {
      "series": "var(--accent), var(--ink-soft), var(--ink-faint)",
      "maxSeries": 3,
      "note": "performans grafiği basamaklı (step) çizgi"
    }
  },
  "motion": {
    "fast": "70ms",
    "base": "130ms",
    "slow": "200ms",
    "easing": "steps(6, end)",
    "properties": [
      "opacity",
      "transform",
      "content"
    ],
    "reduced": "0.01ms (tokens.css global) — sahne ızgarası ve kare geçişleri durur",
    "forbidden": [
      "Sürekli dönen kamera",
      "Renkli glow nabzı",
      "Parallax",
      "Saniyede 1+ flaş"
    ],
    "family": "Deneysel & Gelecek",
    "sequences": {
      "enter": {
        "duration": "0.21s",
        "ease": "steps(6, end)",
        "offsetY": "32px",
        "stagger": "0.02"
      },
      "scroll": {
        "trigger": "top 95%",
        "duration": "0.24s",
        "offsetY": "40px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "70ms",
        "imageScale": "1.050"
      }
    },
    "choreography": {
      "enter": "scale-settle",
      "scroll": "counter",
      "hover": "tilt-3d",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "must": [
    "Viewport ekranın en az %55'i; denetçi paneli sağda sabit",
    "Her varlık satırı tür + kimlik + görünürlük ikonu; kimlik mono",
