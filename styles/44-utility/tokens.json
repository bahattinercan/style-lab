      "height": "44px",
      "padding": "0 12px",
      "radius": "var(--radius)",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "focus": "outline 2px var(--focus), offset 1px",
      "error": "border-color var(--danger) + 12px açıklama"
    },
    "card": {
      "radius": "var(--radius-lg)",
      "padding": "24px",
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "shadow": "var(--shadow)"
    },
    "chip": {
