      "padding": "0 8px",
      "radius": "var(--radius)",
      "font": "12px/600",
      "bg": "var(--surface-2)"
    },
    "nav": {
      "height": "64px",
      "padding": "0 24px",
      "borderBottom": "1px solid var(--line)",
      "backdrop": "blur(var(--blur)) + --bg %80"
    },
    "tableRow": {
      "height": "52px",
      "padding": "12px 16px",
      "border": "alt çizgi 1px var(--line)"
    },
    "modal": {
      "radius": "var(--radius-lg)",
      "padding": "24px",
      "shadow": "0 12px 32px rgba(17,17,18,.12)"
    },
    "toast": {
      "height": "48px",
      "padding": "8px 16px",
      "radius": "var(--radius)",
      "duration": "4000ms (hover'da durur)"
    },
    "chart": {
