      "blur": "24px",
      "backdrop": "rgba(5,5,12,.55)"
    },
    "toast": {
      "height": "46px",
      "radius": "var(--radius)",
      "duration": "4s"
    },
    "chart": {
      "series": "var(--accent) + cyan %70",
      "axis": "10px mono"
    }
  },
  "imagery": {
