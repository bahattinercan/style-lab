    },
    "dark": {
      "bg": "#101220",
      "bg2": "#171a2a",
      "surface": "#1d2752",
      "surface2": "#2a3f8f",
      "ink": "#f7f7f7",
      "inkSoft": "#c9cace",
      "inkFaint": "#92949f",
      "accent": "#ffd98a",
      "accentInk": "#14162a",
      "line": "#f7f7f7"
    }
  },
  "typography": {
    "display": "Press Start 2P",
    "body": "Inter",
    "mono": "Silkscreen",
    "scale": {
      "label": "9px",
      "caption": "12px",
      "small": "14px",
      "body": "16px",
      "h3": "12px",
      "h2": "18px",
      "h1": "28px",
      "h1Mobile": "18px"
    },
    "weights": {
      "body": 400,
      "strong": 400,
      "display": 400
    },
    "lineHeight": {
      "display": 1.4,
      "heading": 1.4,
      "body": 1.6
    },
    "tracking": {
      "display": "0",
      "heading": "0",
      "body": "0",
      "label": "0.06em"
    },
    "measure": "60ch",
    "forbidden": [
      "piksel font gövde metninde",
      "9px altı piksel font",
      "piksel olmayan ölçek"
    ]
  },
  "shape": {
    "radius": "0px",
    "radiusLg": "0px",
    "border": "2px solid var(--line)",
    "outerRing": "0 0 0 4px var(--bg)"
  },
  "elevation": {
    "levels": [
      "bg",
      "karo (blok gölge)",
      "yüzen (6px blok)"
    ],
    "shadow": "0 0 0 2px #f4f4f4, 0 0 0 4px #1a1c2c",
    "shadowHard": "4px 4px 0 #0d0e17",
    "rule": "Derinlik blok gölgeden; blur yok"
  },
  "motion": {
    "fast": "80ms",
    "base": "160ms",
    "slow": "240ms",
    "easing": "steps(2–4)",
    "properties": [
      "clip-path",
      "opacity",
      "transform"
    ],
    "reduced": "blink kapanır",
    "forbidden": [
      "sürekli animasyon",
      "strobe",
      "yumuşak easing"
    ],
    "family": "Retro",
    "sequences": {
      "enter": {
        "duration": "0.3s",
        "ease": "steps(2, end)",
        "offsetY": "6px",
        "stagger": "0.05",
        "note": "steps(6) yalnız dekoratif katmanda"
      },
      "scroll": {
        "trigger": "top 86%",
        "duration": "0.58s",
        "offsetY": "20px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "60ms",
        "imageScale": "1.02"
      }
    },
    "choreography": {
      "enter": "clip-curtain",
      "scroll": "stack-pin",
      "hover": "scale",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "spacing": {
    "unit": "8px",
    "scale": [
      "4px",
      "8px",
      "16px",
      "24px",
      "32px",
      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "64px",
      "mobile": "40px"
    },
    "cardPadding": "16px",
    "gutter": "16px"
  },
  "grid": {
    "columns": 12,
    "gutter": "16px",
    "container": "1120px",
    "breakpoints": {
      "sm": "640px",
      "md": "900px",
      "lg": "1120px"
    },
    "rule": "boşluklar 8'in katı, yarım piksel yok"
  },
  "layout": {
    "hero": "split-reverse",
    "nav": "inline",
    "density": "dense",
    "family": "Retro"
  },
  "components": {
    "button": {
      "height": "44px",
      "padding": "0 18px",
      "radius": "0",
      "font": "10px/400 Press Start",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "border": "2px solid var(--ink)",
      "shadow": "var(--shadow-hard)",
      "states": {
        "hover": "translate(4px,4px) + shadow 0",
        "focus": "outline 2px var(--accent), offset 3px",
        "disabled": "opacity .40"
      }
    },
    "input": {
      "height": "44px",
      "padding": "0 12px",
      "radius": "0",
      "font": "16px/400 Inter",
      "border": "2px solid var(--ink)",
      "focus": "outline 2px var(--accent)"
    },
    "card": {
      "padding": "16px",
      "radius": "0",
      "bg": "var(--surface)",
      "border": "2px solid var(--ink)",
      "shadow": "var(--shadow-hard)"
    },
    "chip": {
      "height": "26px",
      "padding": "0 8px",
      "radius": "0",
      "font": "9px/400 mono",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)"
    },
    "nav": {
      "height": "56px",
      "padding": "0 16px",
      "borderBottom": "4px solid var(--ink)",
      "active": "sarı alt şerit"
    },
    "tableRow": {
      "height": "44px",
      "padding": "8px 10px",
      "border": "2px solid var(--ink) alt"
    },
    "modal": {
      "padding": "20px",
      "radius": "0",
      "border": "4px solid var(--ink)",
      "backdrop": "rgba(13,14,23,.7)"
    },
    "toast": {
      "height": "44px",
      "radius": "0",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "duration": "3s"
    },
    "chart": {
      "series": "accent + surface-2",
      "frame": "2px solid var(--ink)",
      "axis": "9px mono"
    }
  },
  "imagery": {
    "icons": "piksel grid 16/24px, image-rendering: pixelated",
    "photos": "pikselize/duotone",
    "illustration": "sprite seti",
    "texture": "yok (grain 0)",
    "logo": "piksel, uppercase",
    "photo": "urb-02.jpg",
    "treatment": {
      "mode": "duotone",
      "strength": 0.45
    }
  },
  "must": [
    "Radius 0 (istisna yok)",
    "Piksel display yalnız başlık/etiket; gövde Inter ≥ 16px",
    "Çerçeve 2–4px, blok gölge (blur yok)",
    "Palet ≤ 6 renk, yarı saydamlık yok",
    "Görseller pixelated + tam sayı ölçek",
    "Blink/strobe yok"
