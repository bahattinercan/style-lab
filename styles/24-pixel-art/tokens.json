{
  "slug": "pixel-art",
  "num": "24",
  "name": "Pixel Art",
  "version": 4,
  "css": "[data-style=\"pixel-art\"] { --bg: #1a1c2c; --bg-2: #23263a; --surface: #29366f; --surface-2: #3b5dc9; --ink: #f4f4f4; --ink-soft: #c2c3c7; --ink-faint: #8b8d98; --accent: #ffcd75; --accent-ink: #1a1c2c; --line: #f4f4f4; --radius: 0px; --radius-lg: 0px; --shadow: 0 0 0 2px #f4f4f4, 0 0 0 4px #1a1c2c; --shadow-hard: 4px 4px 0 #0d0e17; --font-display: \"Press Start 2P\", \"Silkscreen\", monospace; --font-body: \"Inter\", system-ui, sans-serif; --font-mono: \"Silkscreen\", ui-monospace, monospace; --tracking: 0em; --blur: 0px; --grain: 0; }",
  "palette": {
    "bg": "#1a1c2c",
    "bg2": "#23263a",
    "surface": "#29366f",
    "surface2": "#3b5dc9",
    "ink": "#f4f4f4",
    "inkSoft": "#c2c3c7",
    "inkFaint": "#8b8d98",
    "accent": "#ffcd75",
    "accentInk": "#1a1c2c",
    "line": "#f4f4f4",
    "light": {
      "bg": "#f4f4f4",
      "surface": "#e0e0e6",
      "ink": "#1a1c2c",
      "accent": "#c98a1f",
