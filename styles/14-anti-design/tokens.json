    "shadow": "none",
    "shadowHard": "8px 8px 0 #1b1b1b",
    "rule": "Derinlik blur'suz ofsetten; tek yön"
  },
  "spacing": {
    "unit": "8px",
    "scale": [
      "8px",
      "16px",
      "24px",
      "40px",
      "64px",
      "96px"
    ],
    "sectionY": {
      "desktop": "96px",
      "mobile": "48px"
    },
