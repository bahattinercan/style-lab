      "h2": "56px",
      "h1": "104px",
      "h1Mobile": "48px"
    },
    "weights": {
      "body": 400,
      "strong": 700,
      "display": 400
    },
    "lineHeight": {
      "display": 0.86,
      "heading": 0.9,
      "body": 1.55
    },
    "tracking": {
      "display": "-0.03em",
      "heading": "-0.02em",
      "body": "0",
      "label": "0.18em"
    },
    "transform": {
      "display": "uppercase",
      "button": "uppercase",
      "label": "uppercase",
      "body": "none"
    },
    "forbidden": [
      "18px altında Anton",
      "sahte bold",
      "gövde < 15px"
    ]
  },
  "shape": {
