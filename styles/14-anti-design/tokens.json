{
  "slug": "anti-design",
  "num": "14",
  "name": "Anti-Design",
  "version": 6,
  "css": "[data-style=\"anti-design\"] { --bg: #f2e9da; --bg-2: #d6ff3f; --surface: #ffffff; --surface-2: #ff3b6b; --ink: #1b1b1b; --ink-soft: #4a4a4a; --ink-faint: #7b7b7b; --accent: #fa3667; --accent-ink: #1b1b1b; --line: #1b1b1b; --radius: 0px; --radius-lg: 0px; --shadow: none; --shadow-hard: 8px 8px 0 #1b1b1b; --font-display: \"Anton\", \"Archivo Black\", Impact, sans-serif; --font-body: \"Space Grotesk\", \"Inter\", system-ui, sans-serif; --font-mono: \"JetBrains Mono\", ui-monospace, monospace; --tracking: -0.03em; --blur: 0px; --grain: .05; --focus: #e83863;\n}",
  "palette": {
    "bg": "#f2e9da",
    "bg2": "#d6ff3f",
    "surface": "#ffffff",
    "surface2": "#ff3b6b",
    "ink": "#1b1b1b",
    "inkSoft": "#4a4a4a",
    "inkFaint": "#7b7b7b",
    "accent": "#fa3667",
    "accentInk": "#1b1b1b",
    "line": "#1b1b1b"
  },
  "typography": {
    "display": "Anton",
    "body": "Space Grotesk",
    "mono": "JetBrains Mono",
    "scale": {
      "label": "11px",
