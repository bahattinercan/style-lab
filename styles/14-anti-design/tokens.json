    "nav": "utility",
    "density": "dense",
    "family": "Cesur"
  },
  "components": {
    "button": {
      "height": "52px",
      "padding": "0 26px",
      "radius": "0",
      "font": "15px/700 uppercase",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "border": "3px solid var(--ink)",
      "shadow": "4px 4px 0 var(--ink)",
      "states": {
        "hover": "translate(4px,4px) + shadow 0",
        "focus": "outline 3px var(--ink), offset 3px",
        "disabled": "opacity .40"
      }
    },
    "buttonAcid": {
      "height": "52px",
      "bg": "var(--bg-2)",
      "border": "3px solid var(--ink)"
    },
    "input": {
      "height": "52px",
      "padding": "0 16px",
      "radius": "0",
      "border": "3px solid var(--ink)",
      "focus": "outline 3px var(--accent)"
    },
    "card": {
      "padding": "24px",
      "radius": "0",
      "border": "3px solid var(--ink)",
      "shadow": "8px 8px 0 var(--ink)"
    },
    "chip": {
      "height": "28px",
      "padding": "0 10px",
      "radius": "2px",
      "bg": "var(--bg-2)",
      "border": "2px solid var(--ink)"
    },
    "nav": {
      "height": "76px",
      "padding": "0 32px",
      "borderBottom": "3px solid var(--ink)",
      "active": "6px alt var(--accent)"
    },
    "tableRow": {
      "height": "56px",
      "padding": "12px 16px",
      "border": "2px solid var(--ink) alt"
    },
    "modal": {
      "padding": "32px",
      "radius": "0",
      "border": "3px solid var(--ink)",
      "shadow": "12px 12px 0 var(--ink)",
      "backdrop": "rgba(27,27,27,.40)"
    },
    "toast": {
      "height": "52px",
      "radius": "0",
      "bg": "var(--ink)",
      "color": "var(--bg)"
    },
    "chart": {
      "series": "var(--accent) + var(--bg-2)",
      "frame": "2px solid var(--ink)",
      "axis": "11px mono"
    }
  },
  "imagery": {
    "icons": "3px çizgi, 24px, köşe yok",
    "photos": "yüksek kontrast, sert kırpma, ≤2° rotasyon",
    "illustration": "kolaj/kes-yapıştır",
    "texture": "grain .05, fotokopi lekesi serbest",
    "logo": "dev, crop edilebilir",
    "photo": "obj-02.jpg",
    "treatment": {
      "mode": "duotone",
      "strength": 0.35
    }
  },
  "must": [
    "İhlal bütçesi: ekran başına ≤ 3 ihlal",
    "Metin blokları 0°, gövde ≥ 15px, kontrast ≥ 4.5:1",
    "3px ink kenarlık ve blur'suz ofset gölge (tek yön)",
    "Anton display (uppercase) + Space Grotesk gövde",
    "Radius 0 (chip 2px istisna), hedef ≥ 52px",
    "Ödeme/giriş ekranlarında ihlal 0"
  ],
  "mustNot": [
    "Rastgele rotasyon (3+ öğe veya >3°)",
    "Metin bloğunu döndürmek",
    "Düşük kontrastlı sanatsal metin",
    "Gölge + blur + cam birlikte",
    "Her öğede farklı radius/gölge",
    "İhlali kritik form ekranına taşımak"
