{
  "slug": "editorial-design",
  "num": "03",
  "name": "Editorial Design",
  "version": 4,
  "css": "[data-style=\"editorial-design\"] { --bg: #fdfcf9; --bg-2: #f4f1ea; --surface: #ffffff; --surface-2: #faf8f3; --ink: #141414; --ink-soft: #56504a; --ink-faint: #8e8880; --accent: #b4472f; --accent-ink: #ffffff; --line: rgba(20,20,20,.14); --radius: 2px; --radius-lg: 4px; --shadow: none; --shadow-hard: none; --font-display: \"Fraunces\", \"Playfair Display\", Georgia, serif; --font-body: \"Inter\", system-ui, sans-serif; --font-mono: \"IBM Plex Mono\", ui-monospace, monospace; --tracking: -0.02em; --blur: 0px; --grain: .04; }",
  "palette": {
    "bg": "#fdfcf9",
    "bg2": "#f4f1ea",
    "surface": "#ffffff",
    "surface2": "#faf8f3",
    "ink": "#141414",
    "inkSoft": "#56504a",
    "inkFaint": "#8e8880",
    "accent": "#b4472f",
    "accentInk": "#ffffff",
    "line": "rgba(20,20,20,.14)",
    "dark": {
      "bg": "#14120f",
      "bg2": "#1e1b16",
      "surface": "#1a1714",
      "surface2": "#2b2824",
      "ink": "#f0e9dd",
      "inkSoft": "#b9b0a2",
      "inkFaint": "#77736c",
      "accent": "#d76a4c",
      "accentInk": "#14120f",
      "line": "rgba(240,233,221,.18)"
    }
  },
  "typography": {
    "display": "Fraunces",
    "body": "Inter",
    "mono": "IBM Plex Mono",
    "scale": {
      "label": "10px",
      "caption": "12px",
      "small": "14px",
      "body": "17px",
      "h3": "21px",
      "h2": "32px",
      "h1": "60px",
      "h1Mobile": "34px",
      "quote": "24px"
    },
    "weights": {
      "body": 400,
      "strong": 600,
      "display": 400
    },
    "lineHeight": {
      "display": 1.04,
      "heading": 1.12,
      "body": 1.65,
      "quote": 1.4
    },
    "tracking": {
      "display": "-0.02em",
      "heading": "-0.01em",
      "body": "0",
      "label": "0.2em"
    },
    "measure": "66–72ch (kolonda 46ch)"
  },
  "shape": {
    "radius": "2px",
    "radiusLg": "4px",
    "border": "1px solid var(--line)",
    "maxRadius": "4px"
  },
  "elevation": {
    "levels": [
      "bg",
      "card (1px kenar)",
      "overlay (1px kenar)"
    ],
    "shadow": "none",
    "shadowHard": "none",
    "rule": "Derinlik yok; hairline + zemin tonu"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "300ms",
    "easing": "ease-out / ease-in-out",
    "properties": [
      "opacity",
      "transform"
    ],
    "reduced": "0.01ms",
    "forbidden": [
      "parallax",
      "her paragrafta fade-in"
    ],
    "family": "Sade",
    "sequences": {
      "enter": {
        "duration": "0.55s",
        "ease": "ease-out",
        "offsetY": "10px",
        "stagger": "0.06"
      },
      "scroll": {
        "trigger": "top 88%",
        "duration": "0.65s",
        "offsetY": "24px",
        "once": true
      },
      "pin": {
        "enabled": false,
        "scrub": null,
        "distance": null
      },
      "hover": {
        "duration": "180ms",
        "imageScale": "1.015"
      }
    },
    "choreography": {
      "enter": "line-mask",
      "scroll": "velocity-skew",
      "hover": "scale",
      "page": "crossfade",
      "reduced": "opacity"
    }
  },
  "spacing": {
    "unit": "8px",
    "scale": [
      "4px",
      "8px",
      "12px",
      "16px",
      "24px",
      "32px",
      "48px",
      "64px"
    ],
    "sectionY": {
      "desktop": "64px",
      "mobile": "40px"
    },
    "cardPadding": "24px",
    "gutter": "32px"
  },
  "grid": {
    "columns": "metin 2 kolon (46ch), aralarında 1px dikey kural",
    "gutter": "32px",
    "container": "1140px",
    "measure": "720px",
    "breakpoints": {
      "sm": "640px",
      "md": "900px",
      "lg": "1140px"
    }
  },
  "layout": {
    "hero": "type",
    "nav": "inline",
    "density": "sparse",
    "family": "Sade"
  },
  "components": {
    "button": {
      "height": "44px",
      "padding": "0 20px",
      "radius": "2px",
      "font": "14px/600",
      "bg": "var(--accent)",
      "color": "var(--accent-ink)",
      "states": {
        "hover": "brightness(.92)",
        "focus": "outline 2px var(--accent), offset 2px",
        "disabled": "opacity .40"
      }
    },
    "link": {
      "style": "underline 1px",
      "color": "var(--ink)",
      "hover": "var(--accent)"
    },
    "input": {
      "height": "44px",
      "padding": "0 14px",
      "radius": "2px",
      "border": "1px var(--line) + 2px alt kenar",
      "focus": "alt kenar 2px var(--accent)",
      "error": "var(--danger)"
    },
    "card": {
      "padding": "24px",
      "radius": "var(--radius-lg)",
      "border": "1px var(--line)",
      "shadow": "none"
    },
    "quote": {
      "padding": "24px",
      "bg": "var(--bg-2)",
      "accentBar": "3px sol kenar",
      "font": "Fraunces italic 24/1.4"
    },
    "nav": {
      "height": "68px",
      "padding": "0 40px",
      "font": "12px/600 0.08em uppercase",
      "borderBottom": "1px var(--line)"
    },
    "tableRow": {
      "height": "44px",
      "padding": "10px 12px",
      "border": "1px var(--line) alt"
    },
    "modal": {
      "padding": "32px",
      "radius": "var(--radius-lg)",
      "border": "1px var(--line)",
      "backdrop": "rgba(20,20,20,.40)"
    },
    "toast": {
      "height": "44px",
      "bg": "var(--ink)",
      "color": "var(--bg)"
    },
    "caption": {
      "font": "12px italic",
      "color": "var(--ink-faint)",
      "marginTop": "6px"
    },
    "chart": {
      "series": "var(--accent) + var(--ink-faint) referans",
      "axis": "11px mono"
    }
  },
  "imagery": {
    "icons": "1.5px çizgi, minimal kullanım",
    "photos": "doğal ışık, orta doygunluk, full-bleed veya kolon genişliği; caption zorunlu",
    "illustration": "gravür/elle çizim tonu; 3B yasak",
    "texture": "grain .04 (koyu modda .02)",
    "logo": "serif wordmark, min 24px",
    "photo": "int-01.jpg",
    "treatment": {
      "mode": "plain",
      "strength": 0
    }
  },
  "must": [
    "Serif display + sans gövde ayrımı",
    "Gövde 66–72ch, satır aralığı 1.6–1.65",
    "Geniş ekranda 2 kolon + 1px dikey kural",
    "Hairline (1px) ayırıcı, gölge yok",
    "Drop cap yalnızca açılış paragrafında",
    "Tek sıcak accent ≤ %8 alan",
    "Her görselin altında caption"
  ],
  "mustNot": [
    "Gölge, gradient, cam, radius > 4px",
    "Serif gövde metni (yorgunluk)",
    "Mavi link rengi",
    "Ortalanmış uzun metin / 90ch üzeri satır",
    "3+ font ailesi, 3+ renk",
    "Paragraf başına fade-in animasyonu"
  ],
  "neighbors": {
    "compatible": [
      "luxury-typography",
      "swiss-design",
      "dark-academia"
    ],
    "forbidden": [
      "neo-brutalism",
      "synthwave",
      "bento-grid"
    ]
  },
  "refs": [
